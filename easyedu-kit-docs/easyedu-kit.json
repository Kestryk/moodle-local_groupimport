{
  "name": "easyedu-ui-kit",
  "version": "0.4.49",
  "source": "git@github.com:Kestryk/easyedu-ui-kit.git",
  "status": "stable",
  "consumerSync": {
    "batch": "EED-UI-2026-0073",
    "sourceCommit": "2fc3f0c986e181b4c4a8dbad4228e37d6eec10f5",
    "canonicalScssTree": "63aba95f83573e03b16c1442c17008c51c3c434a",
    "scope": "Mass Import and Administration Phase 0 subset",
    "fullTreeIdentical": false,
    "deferredDriftLedger": "easyedu-ui-kit/docs/audits/easystud-phase0-drift-ledger-2026-09-27.md"
  },
  "packages": {
    "ai": {
      "path": "ai",
      "description": "AI implementation rules, component contracts, audit baseline and passation templates."
    },
    "scss": {
      "path": "scss/easyedu",
      "description": "Reusable SCSS tokens, mixins and component primitives."
    },
    "guide": {
      "path": "guide",
      "description": "Reusable EasyEdu guide/tutorial foundation.",
      "documentation": "docs/components/guide.md",
      "adapterDocumentation": "docs/components/guide-adapter-integration.md"
    },
    "motion": {
      "path": "motion",
      "description": "Cancellable AMD motion controller with reduced-motion and server-policy support.",
      "documentation": "motion/README.md"
    },
    "navigation": {
      "path": "navigation",
      "description": "Normalized desktop and compact navigation context, templates and controller.",
      "documentation": "components/navigation.md"
    },
    "docs": {
      "path": "docs",
      "description": "Architecture, component API and Moodle integration documentation."
    }
  },
  "componentFamilies": [
    "tokens",
    "typography",
    "animations",
    "panels",
    "cards",
    "buttons",
    "forms",
    "dropdowns",
    "tooltips",
    "modals",
    "tables",
    "badges",
    "empty-states",
    "drag-drop",
    "guide",
    "navigation",
    "responsive",
    "orchestration"
  ],
  "quality": {
    "audit": {
      "script": "scripts/audit-kit.ps1",
      "baseline": "ai/audit-baseline.json",
      "strictNewFindingsCommand": "powershell -ExecutionPolicy Bypass -File ./scripts/audit-kit.ps1 -FailOnNewWarning"
    },
    "moodleRulesAudit": {
      "script": "scripts/audit-moodle-rules.ps1",
      "exampleCommand": "powershell -ExecutionPolicy Bypass -File ./scripts/audit-moodle-rules.ps1 -PluginRoot C:/path/to/moodle/local/plugin"
    },
    "guideValidation": {
      "script": "scripts/test-guide-contract.ps1",
      "command": "powershell -ExecutionPolicy Bypass -File ./scripts/test-guide-contract.ps1"
    },
    "phase0MassAdministrationValidation": {
      "script": "scripts/test-phase0-mass-admin-contract.ps1",
      "command": "powershell -ExecutionPolicy Bypass -File ./scripts/test-phase0-mass-admin-contract.ps1"
    },
    "sync": {
      "script": "sync-easyedu-kit.ps1",
      "aiContractsOption": "-IncludeAiContracts",
      "aiContractsTarget": "easyedu-kit-docs/ai"
    }
  },
  "aiContracts": {
    "generalRules": "ai/AI_RULES.md",
    "implementationChecklist": "ai/IMPLEMENTATION_CHECKLIST.md",
    "componentContract": "ai/COMPONENT_CONTRACT.md",
    "guideParityChecklist": "ai/GUIDE_PARITY_CHECKLIST.md",
    "moodlePluginRules": "ai/MOODLE_PLUGIN_RULES.md",
    "moodlePluginReviewChecklist": "ai/MOODLE_PLUGIN_REVIEW_CHECKLIST.md",
    "moodleCodingRules": "ai/MOODLE_CODING_RULES.md",
    "passationTemplate": "ai/PASSATION_TEMPLATE.md"
  },
  "developmentOnly": [
    "ai",
    "docs",
    "examples",
    "scripts",
    "tests"
  ]
}
