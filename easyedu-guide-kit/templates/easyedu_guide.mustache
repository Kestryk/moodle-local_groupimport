<div class="easyedu-guide{{#rootclass}} {{rootclass}}{{/rootclass}}" data-easyedu-guide-root>
    <button type="button" class="btn easyedu-guide__launcher" data-easyedu-guide-open="1" aria-label="{{guideopenlabel}}">
        <span class="easyedu-guide__launcher-icon" aria-hidden="true">
            <span class="fa fa-compass" aria-hidden="true"></span>
        </span>
        <span class="easyedu-guide__launcher-label">{{guideopenlabel}}</span>
    </button>

    <div class="easyedu-guide-modal" data-easyedu-guide-modal hidden role="dialog" aria-label="{{guidetitle}}">
        <div class="easyedu-guide-modal__dialog">
            <header class="easyedu-guide-modal__header">
                <div class="easyedu-guide-modal__title-wrap">
                    <span class="easyedu-guide-modal__hero-icon fa fa-compass" aria-hidden="true"></span>
                    <div>
                        <h2>{{guidetitle}}</h2>
                        <p>{{guidesubtitle}}</p>
                    </div>
                </div>
                {{^discoverypresentation}}
                <div class="easyedu-guide-modal__map-flow" aria-hidden="true">
                    <span class="easyedu-guide-modal__map-item easyedu-guide-modal__map-item--source">
                        <span class="fa fa-sitemap"></span>
                        <span>{{guidemapsource}}</span>
                    </span>
                    <span class="easyedu-guide-modal__map-arrow fa fa-arrow-right"></span>
                    <span class="easyedu-guide-modal__map-item easyedu-guide-modal__map-item--layer">
                        <span class="fa fa-layer-group"></span>
                        <span>{{guidemaplayers}}</span>
                    </span>
                    <span class="easyedu-guide-modal__map-arrow fa fa-arrow-right"></span>
                    <span class="easyedu-guide-modal__map-item easyedu-guide-modal__map-item--banner">
                        <span class="fa fa-image"></span>
                        <span>{{guidemapbanner}}</span>
                    </span>
                </div>
                {{/discoverypresentation}}
                <div class="easyedu-guide-modal__header-actions">
                {{#guidefullscreenenter}}
                <button type="button" class="easyedu-guide-modal__fullscreen" data-easyedu-guide-fullscreen hidden
                    data-enter-label="{{guidefullscreenenter}}" data-exit-label="{{guidefullscreenexit}}"
                    data-unavailable-label="{{guidefullscreenunavailable}}" aria-label="{{guidefullscreenenter}}" aria-pressed="false">
                    <span class="fa fa-expand" aria-hidden="true"></span>
                </button>
                <span class="sr-only" role="status" data-easyedu-guide-fullscreen-status></span>
                {{/guidefullscreenenter}}
                <button type="button" class="btn easyedu-guide-modal__close" data-easyedu-guide-close="1" aria-label="{{guidecloselabel}}">
                    <span class="fa fa-times" aria-hidden="true"></span>
                </button>
                </div>
            </header>

            <div class="easyedu-guide-nav-wrap">
                <button type="button" class="easyedu-guide-nav-arrow easyedu-guide-nav-arrow--prev" data-easyedu-guide-nav-previous="1" aria-label="{{guidepreviouslabel}}">
                    <span class="fa fa-chevron-left" aria-hidden="true"></span>
                </button>
                <nav class="easyedu-guide-modal__nav easyedu-guide-nav" data-easyedu-guide-nav aria-label="{{guidenavigationlabel}}">
                    {{#slides}}
                        <button
                            type="button"
                            class="easyedu-guide-nav-item{{#hasguidedpath}} has-guided-path{{/hasguidedpath}}"
                            data-easyedu-guide-nav-item="{{index}}"
                            {{#hasguidedpath}}data-easyedu-guided-label="{{guidebadgelabel}}"{{/hasguidedpath}}
                            {{#requires}}data-easyedu-guide-requires="{{requires}}"{{/requires}}
                            {{#requireslabel}}data-easyedu-guide-requires-label="{{requireslabel}}"{{/requireslabel}}
                        >
                            <span class="easyedu-guide-nav-item__icon" aria-hidden="true">
                                <span class="fa {{navicon}}" aria-hidden="true"></span>
                            </span>
                            <span class="easyedu-guide-nav-copy">
                                {{#category}}<small>{{category}}</small>{{/category}}
                                {{^category}}{{#hasguidedpath}}<small>{{guideguidedpathlabel}}</small>{{/hasguidedpath}}{{/category}}
                                <span>{{#navtitle}}{{navtitle}}{{/navtitle}}{{^navtitle}}{{title}}{{/navtitle}}</span>
                            </span>
                            {{#requires}}
                                <span class="easyedu-guide-nav-item__requirement" aria-hidden="true">{{#requiresbadge}}{{requiresbadge}}{{/requiresbadge}}{{^requiresbadge}}{{guiderequiresbadge}}{{/requiresbadge}}</span>
                            {{/requires}}
                        </button>
                    {{/slides}}
                </nav>
                <button type="button" class="easyedu-guide-nav-arrow easyedu-guide-nav-arrow--next" data-easyedu-guide-nav-next="1" aria-label="{{guidenextlabel}}">
                    <span class="fa fa-chevron-right" aria-hidden="true"></span>
                </button>
            </div>

            <div class="easyedu-guide-modal__progress">
                <div class="easyedu-guide-modal__progress-track">
                    <span
                        class="easyedu-guide-modal__progress-bar"
                        data-easyedu-guide-progress-bar
                        role="progressbar"
                        aria-label="{{guideprogresslabel}}"
                        aria-valuemin="1"
                        aria-valuemax="{{slidecount}}"
                        aria-valuenow="1"
                        style="width: {{initialprogress}}%;"
                    ></span>
                </div>
                <span class="easyedu-guide-modal__progress-label" data-easyedu-guide-progress-label data-progress-label="{{guidesteplabel}}">1/{{slidecount}}</span>
            </div>

            <div class="easyedu-guide-modal__body">
                {{#slides}}
                    <section
                        class="easyedu-guide-slide{{#visualtype}} easyedu-guide-slide--{{visualtype}}{{/visualtype}}"
                        data-easyedu-guide-slide="{{index}}"
                        {{#requires}}data-easyedu-guide-requires="{{requires}}"{{/requires}}
                        {{#visualtype}}data-easyedu-guide-visual-type="{{visualtype}}"{{/visualtype}}
                        hidden
                    >
                        <span class="easyedu-guide-slide__icon fa {{icon}}" aria-hidden="true"></span>
                        <div>
                            {{#kicker}}<p class="easyedu-guide-slide__kicker">{{kicker}}</p>{{/kicker}}
                            <div class="easyedu-guide-slide__header">
                                <h3>{{title}}</h3>
                                {{#target}}
                                    <button
                                        type="button"
                                        class="btn btn-outline-primary btn-sm easyedu-guide-slide__show"
                                        data-easyedu-guide-show-target="{{#targetselector}}{{targetselector}}{{/targetselector}}{{^targetselector}}{{target}}{{/targetselector}}"
                                        {{#targetselectorcompact}}data-easyedu-guide-show-target-compact="{{targetselectorcompact}}"{{/targetselectorcompact}}
                                        {{#targetselectordesktop}}data-easyedu-guide-show-target-desktop="{{targetselectordesktop}}"{{/targetselectordesktop}}
                                        {{#showopen}}data-easyedu-guide-show-open="{{showopen}}"{{/showopen}}
                                        {{#showopendelay}}data-easyedu-guide-show-open-delay="{{showopendelay}}"{{/showopendelay}}
                                        {{#showafteropen}}data-easyedu-guide-show-after-open="{{showafteropen}}"{{/showafteropen}}
                                        {{#showafteropendelay}}data-easyedu-guide-show-after-open-delay="{{showafteropendelay}}"{{/showafteropendelay}}
                                    >
                                        <span class="fa {{#discoverypresentation}}fa-eye{{/discoverypresentation}}{{^discoverypresentation}}fa-location-arrow{{/discoverypresentation}}" aria-hidden="true"></span>
                                        <span>{{guideshowinterfacelabel}}</span>
                                    </button>
                                {{/target}}
                            </div>
                            <div class="easyedu-guide-slide__content">
                                {{{content}}}
                            </div>
                            {{#commonintroduction}}
                            <div class="easyedu-guide-introduction" data-easyedu-guide-introduction>
                                <dl class="easyedu-guide-introduction__topics">
                                    {{#topics}}
                                    <div class="easyedu-guide-introduction__topic"{{#desktopfullscreen}} data-easyedu-guide-fullscreen-help hidden{{/desktopfullscreen}}>
                                        <dt><span class="fa {{icon}}" aria-hidden="true"></span><span>{{title}}</span></dt>
                                        <dd>{{description}}</dd>
                                    </div>
                                    {{/topics}}
                                </dl>
                                <p class="easyedu-guide-introduction__note">{{note}}</p>
                            </div>
                            {{/commonintroduction}}
                            {{#requires}}
                                <div class="easyedu-guide-slide__locked">
                                    <span class="easyedu-guide-slide__locked-icon fa fa-lock" aria-hidden="true"></span>
                                    <div>
                                        <h4>{{requirestitle}}</h4>
                                        <p>{{requirescontent}}</p>
                                        {{#unlockpath}}
                                            <button type="button" class="btn btn-primary easyedu-guide-slide__start easyedu-guide-slide__unlock" data-easyedu-guide-start-path="{{unlockpath}}">
                                                <span class="fa fa-tasks" aria-hidden="true"></span>
                                                <span>{{unlocklabel}}</span>
                                            </button>
                                        {{/unlockpath}}
                                    </div>
                                </div>
                            {{/requires}}
                            {{#discoveryscene}}
                            {{^concepts}}{{^creation}}
                            <div class="easyedu-guide-scene__live" data-guide-live>
                                <span class="easyedu-guide-scene__live-content">
                                    <span class="fa fa-check-circle" data-guide-live-complete aria-hidden="true" hidden></span>
                                    <span data-guide-live-copy aria-live="polite">{{initiallabel}}</span>
                                    <span class="easyedu-guide-scene__activity" data-guide-activity aria-hidden="true" hidden><span></span><span></span><span></span></span>
                                </span>
                                <span class="easyedu-guide-scene__playback" aria-live="off">
                                    <button type="button" class="easyedu-guide-scene__playback-button" data-guide-playback="pause" data-pause-label="{{pauselabel}}" data-resume-label="{{resumelabel}}" aria-label="{{pauselabel}}" aria-pressed="false" disabled><span class="fa fa-pause" aria-hidden="true"></span></button>
                                    <button type="button" class="easyedu-guide-scene__playback-button" data-guide-playback="next-phase" aria-label="{{nextphaselabel}}" disabled><span class="fa fa-forward" aria-hidden="true"></span></button>
                                </span>
                            </div>
                            {{/creation}}{{/concepts}}
                            <section class="easyedu-guide-scene" data-easyedu-guide-scene="{{kind}}" data-guide-drag-label="{{draglabel}}" data-guide-finished-label="{{finishedlabel}}" data-guide-mobile-participants-label="{{mobileparticipants}}" data-guide-mobile-add-action="{{mobileaddaction}}" data-guide-mobile-add-consequence="{{mobileaddconsequence}}" aria-label="{{caption}}">
                                <p class="easyedu-guide-scene__caption">{{caption}}</p>
                                {{#concepts}}
                                <div class="easyedu-guide-scene__concepts">
                                    <div><div class="easyedu-guide-scene__person"><span class="easyedu-guide-scene__identity fa fa-user" aria-hidden="true"></span><span class="easyedu-guide-scene__card-copy"><strong>Alex Dupont</strong><small>{{participanttitle}}</small></span></div><p>{{participantlabel}}</p><span class="easyedu-guide-scene__concept-arrow fa fa-arrow-right" aria-hidden="true"></span></div>
                                    <div><div class="easyedu-guide-scene__card"><span class="easyedu-guide-scene__identity fa fa-users" aria-hidden="true"></span><span class="easyedu-guide-scene__card-copy"><strong>{{examplegroup}}</strong><small>{{grouptitle}}</small></span></div><p>{{grouplabel}}</p><span class="easyedu-guide-scene__concept-arrow fa fa-arrow-right" aria-hidden="true"></span></div>
                                    <div><div class="easyedu-guide-scene__grouping"><span class="easyedu-guide-scene__identity fa fa-sitemap" aria-hidden="true"></span><span class="easyedu-guide-scene__card-copy"><strong>{{examplegrouping}}</strong><small>{{groupingtitle}}</small></span></div><p>{{groupinglabel}}</p></div>
                                </div>
                                {{/concepts}}
                                {{#creation}}
                                <div class="easyedu-guide-scene__creation-controls">
                                    <label class="easyedu-guide-scene__field"><span>{{patternlabel}}</span>
                                        <input type="text" data-guide-pattern value="{{patternvalue}}" autocomplete="off">
                                    </label>
                                </div>
                                <div class="easyedu-guide-scene__syntax"><span><b>#</b> {{syntaxnumbers}}</span><span><b>@</b> {{syntaxletters}}</span><span><b>*3</b> {{syntaxcount}}</span></div>
                                <p class="easyedu-guide-scene__caption">{{syntaxlabel}}</p>
                                <div class="easyedu-guide-scene__actions">
                                    <button type="button" class="btn btn-primary" data-guide-scene-command="preview">{{previewlabel}}</button>
                                    <button type="button" class="btn btn-outline-secondary" data-guide-scene-command="letters">{{letterslabel}}</button>
                                </div>
                                <div class="easyedu-ui" data-guide-warning-host hidden><div class="easyedu-notice easyedu-notice--warning" role="alert"><span class="fa fa-exclamation-triangle" aria-hidden="true"></span><p data-guide-warning-text>{{invalidlabel}}</p></div></div>
                                <div class="easyedu-guide-scene__result-heading">
                                    <span>{{resulttitle}}</span>
                                    <div class="easyedu-guide-scene__utilities">
                                        <button type="button" class="btn btn-outline-secondary" data-guide-scene-command="clear"><span class="fa fa-arrow-rotate-left" aria-hidden="true"></span><span>{{reset}}</span></button>
                                    </div>
                                </div>
                                <div data-guide-names class="easyedu-guide-scene__results" aria-live="polite" data-invalid="{{invalidlabel}}"></div>
                                <template data-guide-name-card><span class="easyedu-guide-scene__card"><span class="easyedu-guide-scene__identity fa fa-users" aria-hidden="true"></span><span class="easyedu-guide-scene__card-copy"><strong data-guide-name></strong><small>{{emptymembers}}</small></span></span></template>
                                {{/creation}}
                                {{^concepts}}{{^creation}}
                                {{#membership}}<p class="easyedu-guide-scene__intro">{{note}}</p>{{/membership}}
                                <div class="easyedu-guide-scene__stage" data-guide-stage>
                                    <div class="easyedu-guide-scene__source" data-guide-source>
                                        <strong class="easyedu-guide-scene__source-title" data-guide-source-title>Projet Orion</strong>
                                        <div class="easyedu-guide-scene__person" data-guide-person>
                                            <span class="easyedu-guide-scene__identity fa fa-user" aria-hidden="true"></span>
                                            {{#actions}}<span class="easyedu-guide-scene__illustrated-checkbox" aria-hidden="true"><input type="checkbox" tabindex="-1" aria-hidden="true" data-guide-illustrated-checkbox><span class="easyedu-selection-checkbox__ui"></span></span>{{/actions}}
                                            <span class="easyedu-guide-scene__card-copy"><strong>Alex Dupont</strong>{{#membership}}<small>TD lundi · Projet Orion</small>{{/membership}}</span>
                                        </div>
                                        {{#actions}}<div class="easyedu-guide-scene__person"><span class="easyedu-guide-scene__identity fa fa-user" aria-hidden="true"></span><span class="easyedu-guide-scene__illustrated-checkbox" aria-hidden="true"><input type="checkbox" tabindex="-1" aria-hidden="true" data-guide-illustrated-checkbox><span class="easyedu-selection-checkbox__ui"></span></span><span class="easyedu-guide-scene__card-copy"><strong>Léa Martin</strong></span></div>{{/actions}}
                                        <small data-guide-source-empty hidden>{{sourceempty}}</small>
                                    </div>
                                    <div class="easyedu-guide-scene__card" data-guide-destination>
                                        <span class="easyedu-guide-scene__identity fa fa-users" aria-hidden="true"></span>
                                        <span class="easyedu-guide-scene__card-copy"><strong>{{destinationname}}</strong>
                                            <small>{{destinationcaption}}</small><span class="easyedu-guide-scene__member" data-guide-member hidden>Alex Dupont{{#actions}} · Léa Martin{{/actions}}</span>
                                        </span>
                                    </div>
                                    <div class="easyedu-guide-scene__menu" data-guide-menu hidden aria-hidden="true">
                                        <span>{{menutitle}}</span><strong>{{movelabel}}</strong><span data-guide-member-remove>{{removeaction}}</span>
                                    </div>
                                    <div class="easyedu-guide-scene__dialog" data-guide-confirm hidden aria-hidden="true">
                                        <header><strong>{{movelabel}}</strong><span class="fa fa-times" aria-hidden="true"></span></header>
                                        <div><p>{{selectioncaption}}</p><span>{{destinationlabel}}</span><div class="easyedu-guide-scene__destination"><span class="fa fa-search" aria-hidden="true"></span><span>{{destinationname}}</span><span class="fa fa-chevron-down" aria-hidden="true"></span></div><p data-guide-consequence>{{consequence}}</p></div>
                                        <footer><span>{{cancellabel}}</span><strong data-guide-simulated-submit>{{movelabel}}</strong></footer>
                                    </div>
                                    <span class="fa fa-mouse-pointer easyedu-guide-scene__cursor" data-guide-cursor hidden aria-hidden="true"></span>
                                </div>
                                {{#membership}}
                                <div class="easyedu-guide-scene__memberships">
                                    <strong>{{membershiptitle}}</strong>
                                    <span>TD lundi <b>{{keptlabel}}</b></span>
                                    <span data-guide-membership-origin data-kept="{{keptlabel}}" data-removed="{{removedlabel}}">Projet Orion <b>{{keptlabel}}</b></span>
                                    <span data-guide-membership-target data-added="{{addedlabel}}" data-absent="{{absentlabel}}" class="is-absent">{{destinationname}} <b>{{absentlabel}}</b></span>
                                </div>
                                {{/membership}}
                                <section class="easyedu-guide-scene__recap" data-guide-recap hidden>
                                    <strong>{{recaptitle}}</strong>
                                    <ol class="easyedu-guide-scene__steps">
                                        <li data-guide-phase="select" data-add="{{addselect}}" data-compact="{{compactselect}}" data-compact-add="{{mobileaddselect}}">{{selectlabel}}</li>
                                        <li data-guide-phase="menu" data-add="{{adddrop}}" data-compact="{{compactmenu}}" data-compact-add="{{mobileaddmenu}}">{{menulabel}}</li>
                                        <li data-guide-phase="confirm" data-add="{{resultaddlabel}}" data-compact-add="{{mobileaddconfirm}}">{{confirmlabel}}</li>
                                        <li data-guide-phase="validate" data-compact-add="{{mobileaddvalidate}}">{{validatelabel}}</li>
                                    </ol>
                                </section>
                                <div class="easyedu-guide-scene__context">
                                    <p class="easyedu-guide-scene__result" data-guide-result aria-live="polite" data-add="{{resultaddlabel}}" data-move="{{resultmovelabel}}" data-actions="{{resultactionslabel}}">{{initiallabel}}</p>
                                    <p>{{mobilelabel}}</p>
                                    <p>{{note}}</p>
                                </div>
                                <div class="easyedu-guide-scene__actions">
                                    {{#membership}}<button type="button" class="btn btn-primary" data-guide-scene-command="add">{{addlabel}}</button>
                                    <button type="button" class="btn btn-outline-secondary" data-guide-scene-command="move">{{comparemove}}</button>{{/membership}}
                                    <div class="easyedu-guide-scene__utilities">
                                        <button type="button" class="btn btn-outline-secondary" data-guide-scene-command="replay"><span class="fa fa-rotate-right" aria-hidden="true"></span><span>{{replay}}</span></button>
                                        <button type="button" class="btn btn-outline-secondary" data-guide-scene-command="reset"><span class="fa fa-arrow-rotate-left" aria-hidden="true"></span><span>{{reset}}</span></button>
                                    </div>
                                </div>
                                {{/creation}}{{/concepts}}
                            </section>
                            {{/discoveryscene}}
                            {{#hasvisualflow}}
                                <div class="easyedu-guide-visual easyedu-guide-visual--flow" aria-hidden="true">
                                    <span class="easyedu-guide-mini-card easyedu-guide-mini-card--source">
                                        <span class="fa fa-sitemap"></span>
                                        <strong>{{guidemapsource}}</strong>
                                    </span>
                                    <span class="easyedu-guide-flow-arrow fa fa-arrow-right"></span>
                                    <span class="easyedu-guide-mini-card easyedu-guide-mini-card--layer">
                                        <span class="fa fa-layer-group"></span>
                                        <strong>{{guidemaplayers}}</strong>
                                    </span>
                                    <span class="easyedu-guide-flow-arrow fa fa-arrow-right"></span>
                                    <span class="easyedu-guide-mini-card easyedu-guide-mini-card--banner">
                                        <span class="fa fa-image"></span>
                                        <strong>{{guidemapbanner}}</strong>
                                    </span>
                                </div>
                            {{/hasvisualflow}}
                            {{#visualcards}}
                                <div class="easyedu-guide-visual easyedu-guide-visual--cards" aria-hidden="true">
                                    {{#items}}
                                        <span class="easyedu-guide-visual-card{{#type}} easyedu-guide-visual-card--{{type}}{{/type}}">
                                            {{#icon}}<span class="fa {{icon}}" aria-hidden="true"></span>{{/icon}}
                                            <strong>{{title}}</strong>
                                            {{#meta}}<small>{{meta}}</small>{{/meta}}
                                        </span>
                                    {{/items}}
                                </div>
                            {{/visualcards}}
                            {{#visualcarddetail}}
                                <div class="easyedu-guide-visual easyedu-guide-visual--card-detail" aria-hidden="true">
                                    {{#card}}
                                        <span class="easyedu-guide-visual-card{{#type}} easyedu-guide-visual-card--{{type}}{{/type}}">
                                            {{#icon}}<span class="fa {{icon}}" aria-hidden="true"></span>{{/icon}}
                                            <strong>{{title}}</strong>
                                            {{#meta}}<small>{{meta}}</small>{{/meta}}
                                        </span>
                                    {{/card}}
                                    <span class="easyedu-guide-detail-list">
                                        {{#details}}
                                            <span{{#type}} class="easyedu-guide-detail-list__item--{{type}}"{{/type}}>
                                                {{#icon}}<span class="fa {{icon}}" aria-hidden="true"></span>{{/icon}}
                                                <span>{{label}}</span>
                                            </span>
                                        {{/details}}
                                    </span>
                                </div>
                            {{/visualcarddetail}}
                            {{#visualassignment}}
                                <div class="easyedu-guide-visual easyedu-guide-visual--assignment" aria-hidden="true">
                                    {{#rows}}
                                        <span class="easyedu-guide-assignment-row">
                                            {{#items}}
                                                <span class="easyedu-guide-mini-card{{#type}} easyedu-guide-mini-card--{{type}}{{/type}}">
                                                    {{#icon}}<span class="fa {{icon}}" aria-hidden="true"></span>{{/icon}}
                                                    <strong>{{title}}</strong>
                                                    {{#meta}}<small>{{meta}}</small>{{/meta}}
                                                </span>
                                                {{#arrowafter}}<span class="easyedu-guide-flow-arrow fa fa-arrow-right"></span>{{/arrowafter}}
                                            {{/items}}
                                        </span>
                                    {{/rows}}
                                </div>
                            {{/visualassignment}}
                            {{#visualfiltersdemo}}
                                <div class="easyedu-guide-visual easyedu-guide-visual--filters" aria-hidden="true">
                                    <span class="easyedu-guide-fake-search">
                                        <span class="fa fa-search" aria-hidden="true"></span>
                                        <span>{{searchlabel}}</span>
                                    </span>
                                    {{#actions}}
                                        <span class="easyedu-guide-fake-button">{{label}}</span>
                                    {{/actions}}
                                    {{#badges}}
                                        <span class="easyedu-guide-demo-badge{{#type}} easyedu-guide-demo-badge--{{type}}{{/type}}">{{label}}</span>
                                    {{/badges}}
                                </div>
                            {{/visualfiltersdemo}}
                            {{#visualpaste}}
                                <div class="easyedu-guide-visual easyedu-guide-visual--paste" aria-hidden="true">
                                    {{#panels}}
                                        <span class="easyedu-guide-paste-panel">
                                            <strong>
                                                {{#icon}}<span class="fa {{icon}}" aria-hidden="true"></span>{{/icon}}
                                                <span>{{title}}</span>
                                            </strong>
                                            <span class="easyedu-guide-fake-input">{{input}}</span>
                                            <span class="easyedu-guide-chip-row">
                                                {{#chips}}<span>{{.}}</span>{{/chips}}
                                            </span>
                                        </span>
                                        {{#arrowafter}}<span class="easyedu-guide-flow-arrow fa fa-arrow-right"></span>{{/arrowafter}}
                                    {{/panels}}
                                </div>
                            {{/visualpaste}}
                            {{#visualcontextmenu}}
                                <div class="easyedu-guide-visual easyedu-guide-visual--context-menu" aria-hidden="true">
                                    <span class="easyedu-guide-mouse-demo">
                                        <span class="easyedu-guide-mouse-card">
                                            {{#cardicon}}<span class="fa {{cardicon}}" aria-hidden="true"></span>{{/cardicon}}
                                            <strong>{{cardlabel}}</strong>
                                        </span>
                                        <span class="easyedu-guide-mouse-pointer">
                                            <span class="easyedu-guide-mouse-click"></span>
                                        </span>
                                    </span>
                                    <span class="easyedu-guide-demo-menu">
                                        <strong>
                                            <span class="fa fa-mouse-pointer" aria-hidden="true"></span>
                                            <span>{{menutitle}}</span>
                                        </strong>
                                        {{#items}}
                                            <span>{{#icon}}<span class="fa {{icon}}" aria-hidden="true"></span>{{/icon}}{{label}}</span>
                                        {{/items}}
                                    </span>
                                    <span class="easyedu-guide-context-note">{{note}}</span>
                                </div>
                            {{/visualcontextmenu}}
                            {{#visualactionflow}}
                                <div class="easyedu-guide-visual easyedu-guide-visual--action-flow" aria-hidden="true">
                                    <span class="easyedu-guide-selection-stack">
                                        {{#selection}}
                                            <span><span class="fa fa-check-square" aria-hidden="true"></span>{{.}}</span>
                                        {{/selection}}
                                    </span>
                                    <span class="easyedu-guide-fake-button">
                                        {{#actionicon}}<span class="fa {{actionicon}}" aria-hidden="true"></span>{{/actionicon}}
                                        <span>{{actionlabel}}</span>
                                    </span>
                                    <span class="easyedu-guide-modal-preview">
                                        <strong>{{destinationtitle}}</strong>
                                        {{#destinations}}<span>{{.}}</span>{{/destinations}}
                                    </span>
                                </div>
                            {{/visualactionflow}}
                            {{#visualdragdrop}}
                                <div class="easyedu-guide-visual easyedu-guide-visual--drag-drop" aria-hidden="true">
                                    {{#lanes}}
                                        <span class="easyedu-guide-drag-lane">
                                            <span class="easyedu-guide-demo-card{{#sourcetype}} easyedu-guide-demo-card--{{sourcetype}}{{/sourcetype}}">
                                                {{#sourceicon}}<span class="fa {{sourceicon}}" aria-hidden="true"></span>{{/sourceicon}}
                                                <strong>{{sourcelabel}}</strong>
                                            </span>
                                            <span class="easyedu-guide-demo-cursor fa fa-mouse-pointer" aria-hidden="true"></span>
                                            <span class="easyedu-guide-demo-drop">
                                                {{#targeticon}}<span class="fa {{targeticon}}" aria-hidden="true"></span>{{/targeticon}}
                                                <strong>{{targetlabel}}</strong>
                                            </span>
                                        </span>
                                    {{/lanes}}
                                    <span class="easyedu-guide-demo-selection">
                                        {{#selection}}
                                            <span><span class="fa fa-check-square" aria-hidden="true"></span>{{.}}</span>
                                        {{/selection}}
                                    </span>
                                    <span class="easyedu-guide-demo-menu">
                                        {{#menuitems}}
                                            <span>{{#icon}}<span class="fa {{icon}}" aria-hidden="true"></span>{{/icon}}{{label}}</span>
                                        {{/menuitems}}
                                    </span>
                                </div>
                            {{/visualdragdrop}}
                            {{#visualformula}}
                                <div class="easyedu-guide-visual easyedu-guide-visual--formula" aria-hidden="true">
                                    <code>{{expression}}</code>
                                    <span class="easyedu-guide-flow-arrow fa fa-arrow-right"></span>
                                    {{#results}}<span class="easyedu-guide-formula-result">{{.}}</span>{{/results}}
                                </div>
                            {{/visualformula}}
                            {{#visualsteps}}
                                <div class="easyedu-guide-visual easyedu-guide-visual--steps{{#layout}} easyedu-guide-visual--{{layout}}{{/layout}}" aria-hidden="true">
                                    {{#items}}
                                        <span class="easyedu-guide-step-pill{{#state}} easyedu-guide-step-pill--{{state}}{{/state}}">
                                            {{#icon}}<span class="fa {{icon}}" aria-hidden="true"></span>{{/icon}}
                                            <span>{{label}}</span>
                                        </span>
                                    {{/items}}
                                </div>
                            {{/visualsteps}}
                            {{#visualkeys}}
                                <div class="easyedu-guide-visual easyedu-guide-visual--keyboard" aria-hidden="true">
                                    {{#items}}
                                        <span>
                                            <kbd>{{key}}</kbd>
                                            <span>{{label}}</span>
                                        </span>
                                    {{/items}}
                                </div>
                            {{/visualkeys}}
                            {{#guidedpath}}
                                <div class="easyedu-guide-guided-card">
                                    <span class="easyedu-guide-guided-card__icon fa fa-route" aria-hidden="true"></span>
                                    <div class="easyedu-guide-guided-card__body">
                                        {{#guidedpathlabel}}<small>{{guidedpathlabel}}</small>{{/guidedpathlabel}}
                                        <strong>{{#guidedpathtitle}}{{guidedpathtitle}}{{/guidedpathtitle}}{{^guidedpathtitle}}{{title}}{{/guidedpathtitle}}</strong>
                                        <span>{{#guidedpathcontent}}{{guidedpathcontent}}{{/guidedpathcontent}}{{^guidedpathcontent}}{{guideguidedpathlabel}}{{/guidedpathcontent}}</span>
                                        {{#guidedpathsteps}}
                                            <ol class="easyedu-guide-guided-card__steps">
                                                {{#items}}<li>{{.}}</li>{{/items}}
                                            </ol>
                                        {{/guidedpathsteps}}
                                    </div>
                                    <button type="button" class="btn btn-primary easyedu-guide-slide__start" data-easyedu-guide-start-path="{{guidedpath}}">
                                        {{^discoveryscene}}<span class="fa fa-play" aria-hidden="true"></span>{{/discoveryscene}}
                                        <span>{{guidestartpathlabel}}</span>
                                        {{#discoveryscene}}<span class="fa fa-arrow-right" aria-hidden="true"></span>{{/discoveryscene}}
                                    </button>
                                    <div class="easyedu-guide-guided-card__progress" data-easyedu-guide-path-progress hidden>
                                        <small>{{guideresumetitle}}</small>
                                        <button type="button" class="btn btn-outline-secondary easyedu-guide-guided-card__reset" data-easyedu-guide-reset-path="{{guidedpath}}" hidden>{{guideresetpathlabel}}</button>
                                    </div>
                                    <span class="easyedu-guide-scene__caption" data-easyedu-guide-path-status role="status" aria-live="polite"></span>
                                </div>
                            {{/guidedpath}}
                            {{#discoveryscene}}{{#concepts}}
                            <aside class="easyedu-guide-guided-card easyedu-guide-scene__example"><span class="easyedu-guide-guided-card__icon fa fa-route" aria-hidden="true"></span><div class="easyedu-guide-guided-card__body"><strong>{{exampletitle}}</strong><span>{{examplebody}}</span></div></aside>
                            {{/concepts}}{{/discoveryscene}}
                            {{#discoveryscene}}{{#concepts}}<p class="easyedu-guide-scene__note">{{note}}</p>{{/concepts}}{{#creation}}<p class="easyedu-guide-scene__note">{{note}}</p>{{/creation}}{{/discoveryscene}}
                        </div>
                    </section>
                {{/slides}}
            </div>

            {{#discoverypresentation}}
            <div class="easyedu-guide-interface-cue">
                <span class="easyedu-guide-interface-cue__caption">{{guideinterfacecuelabel}}</span>
                <div data-easyedu-guide-interface-cue-action></div>
            </div>
            {{/discoverypresentation}}
            <footer class="easyedu-guide-modal__footer">
                <span class="easyedu-guide-modal__step-count" data-easyedu-guide-progress-label data-progress-label="{{guidesteplabel}}">1/{{slidecount}}</span>
                <div class="easyedu-guide-modal__footer-actions">
                    <button type="button" class="btn btn-outline-secondary" data-easyedu-guide-previous="1">{{guidepreviouslabel}}</button>
                    <button type="button" class="btn btn-primary" data-easyedu-guide-next="1">{{guidenextlabel}}</button>
                </div>
            </footer>
        </div>
    </div>

    <aside class="easyedu-guide-interface-return" data-easyedu-guide-interface-return hidden role="region" aria-label="{{guidereturnlabel}}">
        <div class="easyedu-guide-interface-return__text">
            <strong>{{guidereturnlabel}}</strong>
            <span>{{guidereturndesc}}</span>
        </div>
        <div class="easyedu-guide-interface-return__actions">
            <button type="button" class="btn btn-primary btn-sm easyedu-guide-interface-return__button" data-easyedu-guide-interface-return-button="1">
                <span class="fa {{#discoverypresentation}}fa-compass{{/discoverypresentation}}{{^discoverypresentation}}fa-question-circle{{/discoverypresentation}}" aria-hidden="true"></span>
                <span>{{guidereturnbutton}}</span>
            </button>
            <button
                type="button"
                class="btn btn-outline-secondary btn-sm easyedu-guide-interface-return__dismiss"
                data-easyedu-guide-interface-return-dismiss="1"
                aria-label="{{guidereturndismiss}}"
            >
                <span class="fa fa-times" aria-hidden="true"></span>
            </button>
        </div>
    </aside>
    {{#guidewelcomecopy}}
    <aside class="easyedu-guide-welcome" data-easyedu-guide-welcome hidden role="region" aria-label="{{guidewelcometitle}}">
        <p>{{guidewelcomecopy}}</p>
        <div class="easyedu-guide-welcome__actions">
            <button type="button" class="easyedu-guide-welcome__dismiss" data-easyedu-guide-welcome-dismiss>{{guidewelcomedismiss}}</button>
            <button type="button" class="easyedu-guide-welcome__open" data-easyedu-guide-open>{{guidewelcomeopen}}</button>
        </div>
    </aside>
    {{/guidewelcomecopy}}
    <aside class="easyedu-guide-resume" data-easyedu-guide-resume hidden aria-label="{{guideresumetitle}}">
        <span>{{guideresumetitle}}</span>
        <button type="button" class="btn btn-primary" data-easyedu-guide-resume-path>{{guideresumelabel}}</button>
        <button type="button" class="btn btn-outline-secondary" data-easyedu-guide-cancel-path>{{guidecancelpathlabel}}</button>
    </aside>

    <aside class="easyedu-guide-checklist easyedu-guided-panel" data-easyedu-guide-checklist hidden role="region" aria-label="{{guidechecklisttitle}}">
        <div class="easyedu-guide-checklist__header easyedu-guided-panel__header">
            <div>
                <strong data-easyedu-guide-checklist-title>{{guidechecklisttitle}}</strong>
                <span data-easyedu-guide-checklist-subtitle>{{guideguidedpathlabel}}</span>
            </div>
            <div class="easyedu-guided-panel__header-actions">
                <button type="button" class="btn btn-link easyedu-guided-panel__minimize" data-easyedu-guide-checklist-minimize="1" aria-label="{{guideminimizelabel}}" aria-expanded="true">
                    <span class="fa fa-minus" aria-hidden="true"></span>
                </button>
                <button type="button" class="btn btn-link easyedu-guided-panel__close" data-easyedu-guide-checklist-close="1" aria-label="{{guidecloselabel}}">
                    <span class="fa fa-times" aria-hidden="true"></span>
                </button>
                {{#discoverypresentation}}<button type="button" class="btn btn-outline-secondary easyedu-guided-panel__restore" data-easyedu-guide-checklist-restore="1" aria-expanded="false" hidden><span class="fa fa-expand" aria-hidden="true"></span><span>{{guiderestorelabel}}</span></button>{{/discoverypresentation}}
            </div>
        </div>
        <div class="easyedu-guide-checklist__items easyedu-guided-panel__steps" data-easyedu-guide-checklist-items></div>
        <div
            class="easyedu-guide-checklist__complete easyedu-guided-panel__message"
            data-easyedu-guide-checklist-message
            data-complete-message="{{guidechecklistdonelabel}}"
            role="status"
            aria-live="polite"
            aria-atomic="true"
        >
            <span class="fa fa-location-arrow" aria-hidden="true"></span>
            <span data-easyedu-guide-checklist-message-text>{{guidechecklistdonelabel}}</span>
            <span class="easyedu-guided-panel__message-compact" aria-hidden="true">Everything is set</span>
        </div>
        <div class="easyedu-guided-panel__footer">
            <button type="button" class="btn btn-outline-primary btn-sm easyedu-guided-panel__return" data-easyedu-guide-checklist-return="1">
                <span class="fa fa-question-circle" aria-hidden="true"></span>
                <span>{{guidereturnbutton}}</span>
            </button>
        </div>
    </aside>
</div>
