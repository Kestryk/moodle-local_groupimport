<div class="easyedu-guide{{#rootclass}} {{rootclass}}{{/rootclass}}" data-easyedu-guide-root{{#motionlevel}} data-easyedu-motion-level="{{motionlevel}}" data-easyedu-motion-policy="{{motionpolicy}}"{{/motionlevel}}>
    <button type="button" class="btn easyedu-guide__launcher" data-easyedu-guide-open="1" aria-label="{{guideopenlabel}}">
        <span class="easyedu-guide__launcher-icon" aria-hidden="true">
            <span class="fa fa-compass" aria-hidden="true"></span>
        </span>
        <span class="easyedu-guide__launcher-label">{{guideopenlabel}}</span>
    </button>

    <div class="easyedu-guide-modal" data-easyedu-guide-modal hidden role="dialog" aria-label="{{guidetitle}}">
        <div class="easyedu-guide-modal__dialog">
            <header class="easyedu-guide-modal__header{{#discoverypresentation}} easyedu-dialog-header-palette--primary{{/discoverypresentation}}">
                <div class="easyedu-guide-modal__title-wrap">
                    <span class="easyedu-guide-modal__hero-icon fa fa-compass" aria-hidden="true"></span>
                    <div>
                        {{#guideeyebrow}}<p class="easyedu-guide-modal__eyebrow">{{guideeyebrow}}</p>{{/guideeyebrow}}
                        {{#guidemodaltitle}}<h2>{{#guideeyebrow}}<span class="easyedu-guide-modal__title-full">{{/guideeyebrow}}{{guidemodaltitle}}{{#guideeyebrow}}</span><span class="easyedu-guide-modal__title-short">{{guideeyebrow}}</span>{{/guideeyebrow}}</h2>{{/guidemodaltitle}}
                        {{^guidemodaltitle}}<h2>{{guidetitle}}</h2>{{/guidemodaltitle}}
                        {{^guideeyebrow}}<p>{{guidesubtitle}}</p>{{/guideeyebrow}}
                    </div>
                </div>
                {{^discoverypresentation}}
                <div class="easyedu-guide-modal__map-flow" aria-hidden="true">
                    <span class="easyedu-guide-modal__map-item easyedu-guide-modal__map-item--source">
                        <span class="fa fa-sitemap"></span>
                        <span>{{guidemapsource}}</span>
                    </span>
                    <span class="easyedu-guide-modal__map-arrow fa fa-arrow-right"></span>
                    <span class="easyedu-guide-modal__map-item easyedu-guide-modal__map-item--layer">
                        <span class="fa fa-layer-group"></span>
                        <span>{{guidemaplayers}}</span>
                    </span>
                    <span class="easyedu-guide-modal__map-arrow fa fa-arrow-right"></span>
                    <span class="easyedu-guide-modal__map-item easyedu-guide-modal__map-item--banner">
                        <span class="fa fa-image"></span>
                        <span>{{guidemapbanner}}</span>
                    </span>
                </div>
                {{/discoverypresentation}}
                <div class="easyedu-guide-modal__header-actions">
                {{#guidefullscreenenter}}
                <button type="button" class="easyedu-guide-modal__fullscreen" data-easyedu-guide-fullscreen hidden
                    data-enter-label="{{guidefullscreenenter}}" data-exit-label="{{guidefullscreenexit}}"
                    data-unavailable-label="{{guidefullscreenunavailable}}" aria-label="{{guidefullscreenenter}}" aria-pressed="false">
                    {{#discoverypresentation}}
                    <svg class="easyedu-guide-fullscreen-glyph" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                        <path data-easyedu-guide-fullscreen-glyph
                            data-enter-path="M3 6V3H6M10 3H13V6M13 10V13H10M6 13H3V10"
                            data-exit-path="M6 3V6H3M13 6H10V3M10 13V10H13M3 10H6V13"
                            d="M3 6V3H6M10 3H13V6M13 10V13H10M6 13H3V10" />
                    </svg>
                    {{/discoverypresentation}}
                    {{^discoverypresentation}}<span class="fa fa-expand" aria-hidden="true"></span>{{/discoverypresentation}}
                </button>
                <span class="sr-only" role="status" data-easyedu-guide-fullscreen-status></span>
                {{/guidefullscreenenter}}
                <button type="button" class="btn easyedu-guide-modal__close" data-easyedu-guide-close="1" aria-label="{{guidecloselabel}}">
                    {{#discoverypresentation}}<span aria-hidden="true">&times;</span>{{/discoverypresentation}}
                    {{^discoverypresentation}}<span class="fa fa-times" aria-hidden="true"></span>{{/discoverypresentation}}
                </button>
                </div>
            </header>

            <div class="easyedu-guide-nav-wrap">
                <button type="button" class="easyedu-guide-nav-arrow easyedu-guide-nav-arrow--prev" data-easyedu-guide-nav-previous="1" aria-label="{{guidepreviouslabel}}">
                    <span class="fa fa-chevron-left" aria-hidden="true"></span>
                </button>
                <nav class="easyedu-guide-modal__nav easyedu-guide-nav" data-easyedu-guide-nav aria-label="{{guidenavigationlabel}}">
                    {{#slides}}
                        <button
                            type="button"
                            class="easyedu-guide-nav-item{{#hasguidedpath}} has-guided-path{{/hasguidedpath}}"
                            data-easyedu-guide-nav-item="{{index}}"
                            {{#hasguidedpath}}data-easyedu-guided-label="{{guidebadgelabel}}"{{/hasguidedpath}}
                            {{#requires}}data-easyedu-guide-requires="{{requires}}"{{/requires}}
                            {{#requireslabel}}data-easyedu-guide-requires-label="{{requireslabel}}"{{/requireslabel}}
                            data-easyedu-guide-bubble="{{#navtooltip}}{{navtooltip}}{{/navtooltip}}{{^navtooltip}}{{title}}{{/navtooltip}}" data-easyedu-guide-bubble-when="truncated"
                        >
                            <span class="easyedu-guide-nav-item__icon" aria-hidden="true">
                                <span class="fa {{navicon}}" aria-hidden="true"></span>
                            </span>
                            <span class="easyedu-guide-nav-copy">
                                <span class="easyedu-guide-nav-item__meta">
                                    {{#navcategorymanaged}}{{#navcategorylabel}}<small>{{navcategorylabel}}</small>{{/navcategorylabel}}{{/navcategorymanaged}}
                                    {{^navcategorymanaged}}
                                        {{#category}}<small>{{category}}</small>{{/category}}
                                        {{^category}}{{#hasguidedpath}}<small>{{guideguidedpathlabel}}</small>{{/hasguidedpath}}{{/category}}
                                    {{/navcategorymanaged}}
                                    {{#hasguidedpath}}<span class="easyedu-guide-nav-item__path" aria-hidden="true">{{guidebadgelabel}}</span>{{/hasguidedpath}}
                                </span>
                                <span class="easyedu-guide-nav-item__label">{{#navnumber}}<span class="easyedu-guide-nav-item__number">{{navnumber}}</span><span class="easyedu-guide-nav-item__sep"> · </span>{{/navnumber}}<span class="easyedu-guide-nav-item__text">{{#navtitle}}{{navtitle}}{{/navtitle}}{{^navtitle}}{{title}}{{/navtitle}}</span></span>
                            </span>
                            {{#hasguidedpath}}<span class="sr-only">{{guidebadgelabel}}</span>{{/hasguidedpath}}
                            {{#requires}}
                                <span class="easyedu-guide-nav-item__requirement" aria-hidden="true">{{#requiresbadge}}{{requiresbadge}}{{/requiresbadge}}{{^requiresbadge}}{{guiderequiresbadge}}{{/requiresbadge}}</span>
                            {{/requires}}
                        </button>
                    {{/slides}}
                </nav>
                <button type="button" class="easyedu-guide-nav-arrow easyedu-guide-nav-arrow--next" data-easyedu-guide-nav-next="1" aria-label="{{guidenextlabel}}">
                    <span class="fa fa-chevron-right" aria-hidden="true"></span>
                </button>
            </div>

            <div class="easyedu-guide-modal__progress">
                <div class="easyedu-guide-modal__progress-track">
                    <span
                        class="easyedu-guide-modal__progress-bar"
                        data-easyedu-guide-progress-bar
                        role="progressbar"
                        aria-label="{{guideprogresslabel}}"
                        aria-valuemin="1"
                        aria-valuemax="{{slidecount}}"
                        aria-valuenow="1"
                        style="width: {{initialprogress}}%;"
                    ></span>
                </div>
                <span class="easyedu-guide-modal__progress-label" data-easyedu-guide-progress-label data-progress-label="{{guidesteplabel}}">1/{{slidecount}}</span>
            </div>

            <div class="easyedu-guide-modal__body">
                {{#slides}}
                    <section
                        class="easyedu-guide-slide{{#visualtype}} easyedu-guide-slide--{{visualtype}}{{/visualtype}}"
                        data-easyedu-guide-slide="{{index}}"
                        {{#requires}}data-easyedu-guide-requires="{{requires}}"{{/requires}}
                        {{#visualtype}}data-easyedu-guide-visual-type="{{visualtype}}"{{/visualtype}}
                        hidden
                    >
                        <span class="easyedu-guide-slide__icon fa {{icon}}" aria-hidden="true"></span>
                        <div>
                            {{#kicker}}<p class="easyedu-guide-slide__kicker">{{kicker}}</p>{{/kicker}}
                            <div class="easyedu-guide-slide__header">
                                <h3>{{title}}</h3>
                                {{#target}}
                                    <button
                                        type="button"
                                        class="btn btn-outline-primary btn-sm easyedu-guide-slide__show"
                                        data-easyedu-guide-show-target="{{#targetselector}}{{targetselector}}{{/targetselector}}{{^targetselector}}{{target}}{{/targetselector}}"
                                        {{#targetselectorcompact}}data-easyedu-guide-show-target-compact="{{targetselectorcompact}}"{{/targetselectorcompact}}
                                        {{#targetselectordesktop}}data-easyedu-guide-show-target-desktop="{{targetselectordesktop}}"{{/targetselectordesktop}}
                                        {{#showopen}}data-easyedu-guide-show-open="{{showopen}}"{{/showopen}}
                                        {{#showopendelay}}data-easyedu-guide-show-open-delay="{{showopendelay}}"{{/showopendelay}}
                                        {{#showafteropen}}data-easyedu-guide-show-after-open="{{showafteropen}}"{{/showafteropen}}
                                        {{#showafteropendelay}}data-easyedu-guide-show-after-open-delay="{{showafteropendelay}}"{{/showafteropendelay}}
                                        {{#discoverypresentation}}data-easyedu-guide-bubble="{{guideinterfacecuelabel}}"{{/discoverypresentation}}
                                    >
                                        <span class="fa {{#discoverypresentation}}fa-eye{{/discoverypresentation}}{{^discoverypresentation}}fa-location-arrow{{/discoverypresentation}}" aria-hidden="true"></span>
                                        <span class="easyedu-guide-slide__show-label">{{guideshowinterfacelabel}}</span>
                                    </button>
                                {{/target}}
                            </div>
                            <div class="easyedu-guide-slide__content">
                                {{{content}}}
                            </div>
                            {{#requires}}
                                <div class="easyedu-guide-slide__locked">
                                    <span class="easyedu-guide-slide__locked-icon fa fa-lock" aria-hidden="true"></span>
                                    <div>
                                        <h4>{{requirestitle}}</h4>
                                        <p>{{requirescontent}}</p>
                                        {{#unlockpath}}
                                            <button type="button" class="btn btn-primary easyedu-guide-slide__start easyedu-guide-slide__unlock" data-easyedu-guide-start-path="{{unlockpath}}">
                                                <span class="fa fa-tasks" aria-hidden="true"></span>
                                                <span>{{unlocklabel}}</span>
                                            </button>
                                        {{/unlockpath}}
                                    </div>
                                </div>
                            {{/requires}}
                            {{#discoveryscene}}
                            <section class="easyedu-guide-scene" data-easyedu-guide-scene="{{kind}}" data-guide-drag-label="{{draglabel}}" data-guide-finished-label="{{finishedlabel}}" data-guide-mobile-participants-label="{{mobileparticipants}}" data-guide-mobile-add-action="{{mobileaddaction}}" data-guide-mobile-add-submit="{{mobileaddsubmit}}" data-guide-mobile-add-consequence="{{mobileaddconsequence}}" aria-label="{{caption}}">
                                <p class="easyedu-guide-scene__caption easyedu-guide-scene__caption--safe-example"><span class="easyedu-guide-scene__caption-full">{{caption}}</span><span class="easyedu-guide-scene__caption-short">{{captionshort}}</span></p>
                            {{^concepts}}{{^creationstatic}}
                            <header class="easyedu-guide-scene__header{{^membership}} easyedu-guide-scene__header--single{{/membership}}" data-guide-scene-header data-step-label="{{steplabel}}" data-ready-label="{{readylabel}}" data-paused-label="{{pausedlabel}}" data-add-label="{{addmodelabel}}" data-move-label="{{movemodelabel}}">
                                <div class="easyedu-guide-scene__header-controls">
                                <div class="easyedu-guide-scene__header-controls-inner">
                                    {{#membership}}
                                    <fieldset class="easyedu-guide-scene__modes easyedu-segmented-choice" data-guide-modes>
                                        <legend class="easyedu-segmented-choice__legend">{{comparelabel}}</legend>
                                        <span class="easyedu-segmented-choice__label" aria-hidden="true">{{comparelabel}}</span>
                                        <div class="easyedu-segmented-choice__options">
                                            <label class="easyedu-segmented-choice__option">
                                                <input type="radio" class="easyedu-segmented-choice__input" name="easyedu-guide-membership-mode" value="add" data-guide-scene-command="add" checked>
                                                <span class="easyedu-segmented-choice__surface"><span class="fa fa-plus" aria-hidden="true"></span><span><strong>{{addmodelabel}}</strong><small>{{addmodehint}}</small></span></span>
                                            </label>
                                            <label class="easyedu-segmented-choice__option">
                                                <input type="radio" class="easyedu-segmented-choice__input" name="easyedu-guide-membership-mode" value="move" data-guide-scene-command="move">
                                                <span class="easyedu-segmented-choice__surface"><span class="fa fa-right-left" aria-hidden="true"></span><span><strong>{{movemodelabel}}</strong><small>{{movemodehint}}</small></span></span>
                                            </label>
                                        </div>
                                    </fieldset>
                                    {{/membership}}
                                    {{#manualstart}}
                                    <button type="button" class="btn btn-primary easyedu-guide-scene__start" data-guide-scene-command="start" data-start-label="{{startlabel}}" data-running-label="{{runninglabel}}" data-replay-label="{{replaylabel}}" aria-busy="false"><span class="fa fa-play" aria-hidden="true"></span><span data-guide-start-label>{{startlabel}}</span></button>
                                    {{/manualstart}}
                                </div>
                                </div>
                            <div class="easyedu-guide-scene__reading">
                            <span class="easyedu-guide-scene__phase-caption" data-guide-phase-caption hidden></span>
                            <div class="easyedu-guide-scene__live" data-guide-live>
                                <span class="easyedu-guide-scene__live-content">
                                    <span class="fa fa-check-circle" data-guide-live-complete aria-hidden="true" hidden></span>
                                    <span class="sr-only" data-guide-live-announcement aria-live="polite">{{initiallabel}}</span>
                                    <span data-guide-live-copy aria-hidden="true">{{initiallabel}}</span><span class="easyedu-guide-scene__activity" data-guide-activity aria-hidden="true" hidden><span></span><span></span><span></span></span>
                                </span>
                                <span class="easyedu-guide-scene__playback" aria-live="off">
                                    <button type="button" class="easyedu-guide-scene__playback-button" data-guide-playback="pause" data-pause-label="{{pauselabel}}" data-resume-label="{{resumelabel}}" aria-label="{{pauselabel}}" aria-pressed="false" disabled><span class="fa fa-pause" aria-hidden="true"></span></button>
                                    <button type="button" class="easyedu-guide-scene__playback-button" data-guide-playback="next-phase" aria-label="{{nextphaselabel}}" disabled><span class="fa fa-forward" aria-hidden="true"></span></button>
                                </span>
                            </div>
                            </div>
                            </header>
                            {{/creationstatic}}{{/concepts}}
                                {{#concepts}}
                                <div class="easyedu-guide-scene__concepts">
                                    <div><div class="easyedu-guide-scene__person"><span class="easyedu-guide-scene__identity fa fa-user" aria-hidden="true"></span><span class="easyedu-guide-scene__card-copy"><strong>Alex Dupont</strong><small>{{participanttitle}}</small></span></div><p>{{participantlabel}}</p><span class="easyedu-guide-scene__concept-arrow fa fa-arrow-right" aria-hidden="true"></span></div>
                                    <div><div class="easyedu-guide-scene__card"><span class="easyedu-guide-scene__identity fa fa-users" aria-hidden="true"></span><span class="easyedu-guide-scene__card-copy"><strong>{{examplegroup}}</strong><small>{{grouptitle}}</small></span></div><p>{{grouplabel}}</p><span class="easyedu-guide-scene__concept-arrow fa fa-arrow-right" aria-hidden="true"></span></div>
                                    <div><div class="easyedu-guide-scene__grouping"><span class="easyedu-guide-scene__identity fa fa-layer-group" aria-hidden="true"></span><span class="easyedu-guide-scene__card-copy"><strong>{{examplegrouping}}</strong><small>{{groupingtitle}}</small></span></div><p>{{groupinglabel}}</p></div>
                                </div>
                                {{/concepts}}
                                {{#creation}}
                                <div class="easyedu-guide-scene__creation-stage" data-guide-stage
                                    data-guide-phase-1-label="{{creationphase1}}" data-guide-phase-2-label="{{creationphase2}}"
                                    data-guide-phase-3-label="{{creationphase3}}" data-guide-creation-list="{{creationlist}}"
                                    data-guide-creation-formula="{{creationformula}}" data-guide-creation-groupings="{{creationgroupings}}">
                                <div class="easyedu-guide-scene__creation-controls">
                                    <label class="easyedu-guide-scene__field"><span data-guide-pattern-label data-grouping-label="{{creationgroupinglabel}}">{{patternlabel}}</span>
                                        <input type="text" data-guide-pattern value="{{patternvalue}}" autocomplete="off">
                                    </label>
                                </div>
                                <div class="easyedu-guide-scene__syntax"><span><b>#</b> {{syntaxnumbers}}</span><span><b>@</b> {{syntaxletters}}</span><span><b>*3</b> {{syntaxcount}}</span></div>
                                <p class="easyedu-guide-scene__caption">{{syntaxlabel}}</p>
                                <div class="easyedu-guide-scene__actions">
                                    <button type="button" class="btn btn-primary" data-guide-scene-command="preview">{{previewlabel}}</button>
                                    <button type="button" class="btn btn-outline-secondary" data-guide-scene-command="letters">{{letterslabel}}</button>
                                </div>
                                <div class="easyedu-ui" data-guide-warning-host hidden><div class="easyedu-notice easyedu-notice--warning" role="alert"><span class="fa fa-exclamation-triangle" aria-hidden="true"></span><p data-guide-warning-text>{{invalidlabel}}</p></div></div>
                                <div class="easyedu-guide-scene__result-heading">
                                    <span>{{resulttitle}}</span>
                                    <div class="easyedu-guide-scene__utilities">
                                        <button type="button" class="btn btn-outline-secondary" data-guide-scene-command="clear"><span class="fa fa-arrow-rotate-left" aria-hidden="true"></span><span>{{reset}}</span></button>
                                    </div>
                                </div>
                                <div data-guide-names class="easyedu-guide-scene__results" aria-live="polite" data-invalid="{{invalidlabel}}"></div>
                                <div class="easyedu-guide-scene__grouping-block" data-guide-grouping-block hidden>
                                    <div class="easyedu-guide-scene__result-heading"><span>{{creationgroupingresult}}</span></div>
                                    <div data-guide-grouping-names class="easyedu-guide-scene__results" aria-live="polite"></div>
                                </div>
                                <template data-guide-grouping-card><span class="easyedu-guide-scene__grouping"><span class="easyedu-guide-scene__identity fa fa-layer-group" aria-hidden="true"></span><span class="easyedu-guide-scene__card-copy"><strong data-guide-name></strong><small>{{emptygroups}}</small></span></span></template>
                                <span class="easyedu-guide-scene__cursor" data-guide-cursor hidden aria-hidden="true"><span class="fa fa-mouse-pointer easyedu-guide-scene__cursor-mouse"></span><span class="easyedu-guide-scene__cursor-touch" data-guide-cursor-touch><span class="easyedu-guide-scene__cursor-ripple" data-guide-cursor-ripple></span></span></span>
                                <template data-guide-name-card><span class="easyedu-guide-scene__card"><span class="easyedu-guide-scene__identity fa fa-users" aria-hidden="true"></span><span class="easyedu-guide-scene__card-copy"><strong data-guide-name></strong><small>{{emptymembers}}</small></span></span></template>
                                </div>
                                {{/creation}}
                                {{#simplecreate}}{{> guide_simplecreate}}{{/simplecreate}}
                                {{#miscene}}{{> guide_mass_import_scene}}{{/miscene}}
                                {{^concepts}}{{^creation}}{{^simplecreate}}{{^miscene}}
                                {{#inspection}}
                                <div class="easyedu-guide-scene__creation-controls easyedu-guide-scene__inspection-stage" data-guide-stage>
                                    <div class="easyedu-guide-scene__inspection-card{{#grouping}} easyedu-guide-scene__inspection-card--grouping{{/grouping}}" data-guide-inspection-card>
                                        <span class="easyedu-guide-scene__identity fa {{cardicon}}" aria-hidden="true"></span>
                                        <div class="easyedu-guide-scene__inspection-header">
                                            <span class="easyedu-guide-scene__card-copy"><strong>{{cardtitle}}</strong><small>{{cardmeta}}</small></span>
                                            <span class="easyedu-guide-scene__inspection-desktop-trigger" data-guide-inspection-trigger data-easyedu-guide-bubble="{{actionlabel}}" aria-hidden="true"><span class="fa {{actionicon}}" aria-hidden="true"></span></span>
                                            <span class="easyedu-guide-scene__inspection-mobile-trigger" data-guide-inspection-mobile-trigger hidden aria-hidden="true"><span class="fa fa-ellipsis" aria-hidden="true"></span></span>
                                        </div>
                                        <div class="easyedu-guide-scene__inspection-menu" data-guide-inspection-menu hidden aria-hidden="true"><span>{{menutitle}}</span><strong><span class="fa {{actionicon}}" aria-hidden="true"></span> {{actionlabel}}</strong></div>
                                        <div class="easyedu-guide-scene__inspection-panel" data-guide-inspection-panel hidden>
                                            <label class="easyedu-guide-scene__field"><span>{{inputlabel}}</span><textarea rows="3" readonly tabindex="-1" data-guide-inspection-input data-guide-example-value="{{inputvalue}}"></textarea></label>
                                            <div class="easyedu-guide-scene__inspection-chips" data-guide-inspection-chips hidden><span>{{knownlabel}}</span><span class="is-unresolved">{{unknownlabel}}</span></div>
                                            <div class="easyedu-guide-scene__actions" aria-hidden="true"><span class="easyedu-guide-scene__inspection-submit">{{addlabel}}</span><span class="easyedu-guide-scene__inspection-trigger" data-guide-inspection-cancel>{{cancellabel}}</span></div>
                                        </div>
                                    </div>
                                    <span class="easyedu-guide-scene__cursor" data-guide-inspection-cursor hidden aria-hidden="true"><span class="fa fa-mouse-pointer easyedu-guide-scene__cursor-mouse"></span><span class="easyedu-guide-scene__cursor-touch" data-guide-cursor-touch><span class="easyedu-guide-scene__cursor-ripple" data-guide-cursor-ripple></span></span></span>
                                </div>
                                <section class="easyedu-guide-scene__recap" data-guide-recap hidden>
                                    <button type="button" class="easyedu-guide-scene__recap-toggle" data-guide-recap-toggle aria-expanded="true"><strong>{{recaptitle}}</strong><span class="fa fa-chevron-down" aria-hidden="true"></span></button>
                                    <div class="easyedu-guide-scene__recap-body" data-guide-recap-body><ol class="easyedu-guide-scene__steps">{{#phases}}<li data-guide-phase="{{name}}"{{#compactlabel}} data-compact="{{compactlabel}}"{{/compactlabel}}>{{label}}</li>{{/phases}}</ol></div>
                                </section>
                                <div class="easyedu-guide-scene__context"><p class="easyedu-guide-scene__result" data-guide-result data-inspection="{{resultlabel}}" aria-live="polite">{{initiallabel}}</p><p>{{note}}</p></div>
                                <div class="easyedu-guide-scene__actions"><div class="easyedu-guide-scene__utilities">{{^manualstart}}<button type="button" class="btn btn-outline-secondary" data-guide-scene-command="replay"><span class="fa fa-rotate-right" aria-hidden="true"></span><span>{{replay}}</span></button>{{/manualstart}}<button type="button" class="btn btn-outline-secondary" data-guide-scene-command="reset"><span class="fa fa-arrow-rotate-left" aria-hidden="true"></span><span>{{reset}}</span></button></div></div>
                                {{/inspection}}
                                {{#filtersdemo}}
                                <div class="easyedu-guide-spec easyedu-guide-spec--filters easyedu-guide-scene__filters-stage" data-guide-stage aria-hidden="true"
                                    data-guide-phase-1-label="{{filtersstep1}}" data-guide-phase-2-label="{{filtersstep2}}"
                                    data-guide-phase-3-label="{{filtersstep3}}" data-guide-phase-4-label="{{filtersstep4}}"
                                    data-guide-filters-query="TD" data-guide-count-all="{{filterscountall}}" data-guide-count-filtered="{{filterscountfiltered}}"
                                    data-guide-select-label="{{filtersselect}}" data-guide-deselect-label="{{filtersdeselect}}">
                                    <div class="easyedu-guide-spec__surface">
                                        <span class="easyedu-search-field"><span class="fa fa-search" aria-hidden="true"></span><input type="search" class="form-control" value="" readonly tabindex="-1" aria-hidden="true" data-guide-filters-input></span>
                                        <div class="easyedu-guide-spec__filter is-spacer" data-guide-filters-role aria-hidden="true"><span class="easyedu-guide-spec__filter-label">{{filtersrole}}</span><span class="local-groupimport-easystud-token local-groupimport-easystud-token--role">{{filtersrolevalue}}</span></div>
                                        <div class="easyedu-guide-spec__bar"><span class="btn btn-sm btn-outline-secondary easyedu-guide-spec__select" data-guide-filters-select>{{filtersselect}}</span><span class="easyedu-guide-spec__count" data-guide-filters-count>{{filterscountall}}</span></div>
