                                    <span class="easyedu-guide-guided-card__icon fa fa-route" aria-hidden="true"></span>
                                    <div class="easyedu-guide-guided-card__body">
                                        {{#guidedpathlabel}}<small>{{guidedpathlabel}}</small>{{/guidedpathlabel}}
                                        <strong>{{#guidedpathtitle}}{{guidedpathtitle}}{{/guidedpathtitle}}{{^guidedpathtitle}}{{title}}{{/guidedpathtitle}}</strong>
                                        <span>{{#guidedpathcontent}}{{guidedpathcontent}}{{/guidedpathcontent}}{{^guidedpathcontent}}{{guideguidedpathlabel}}{{/guidedpathcontent}}</span>
                                        {{#guidedpathsteps}}
                                            <ol class="easyedu-guide-guided-card__steps">
                                                {{#items}}<li>{{.}}</li>{{/items}}
                                            </ol>
                                        {{/guidedpathsteps}}
                                        {{#guidedpathwarning}}
                                        {{! K18-07: the path works on the teacher's real file; Kit warning notice. }}
                                        <div class="easyedu-ui" data-easyedu-guide-path-warning><div class="easyedu-notice easyedu-notice--warning" role="note"><span class="fa fa-exclamation-triangle" aria-hidden="true"></span><p>{{guidedpathwarning}}</p></div></div>
                                        {{/guidedpathwarning}}
                                    </div>
                                    <button type="button" class="btn btn-primary easyedu-guide-slide__start" data-easyedu-guide-start-path="{{guidedpath}}" data-start-label="{{guidestartpathlabel}}" data-resume-label="{{guideresumeguidedlabel}}">
                                        <span data-easyedu-guide-start-label>{{guidestartpathlabel}}</span>
                                        <span class="fa fa-arrow-right" aria-hidden="true"></span>
                                    </button>
                                    <div class="easyedu-guide-guided-card__progress" data-easyedu-guide-path-progress hidden>
                                        <button type="button" class="btn btn-outline-secondary easyedu-guide-guided-card__reset" data-easyedu-guide-reset-path="{{guidedpath}}" hidden>{{guideresetpathlabel}}</button>
                                    </div>
                                    <span class="easyedu-guide-scene__caption" data-easyedu-guide-path-status role="status" aria-live="polite"></span>
                                </div>
                            {{/guidedpath}}
                            {{#discoveryscene}}{{#concepts}}
                            <div class="easyedu-ui easyedu-guide-scene__example"><aside class="easyedu-notice"><span class="fa fa-info-circle" aria-hidden="true"></span><div><strong>{{exampletitle}}</strong><p>{{examplebody}}</p></div></aside></div>
                            {{/concepts}}{{/discoveryscene}}
                            {{#discoveryscene}}{{#concepts}}<p class="easyedu-guide-scene__note">{{note}}</p>{{/concepts}}{{/discoveryscene}}
                        </div>
                    </section>
                {{/slides}}
            </div>

            <footer class="easyedu-guide-modal__footer">
                <div class="easyedu-guide-modal__footer-primary">
                <button type="button" class="easyedu-direct-icon" data-easyedu-display-open
                    data-easyedu-display-tooltip
                    aria-label="{{displaypreferenceslabel}}">
                    <span class="fa fa-sliders" aria-hidden="true"></span>
                    <span class="sr-only">{{displaypreferenceslabel}}</span>
                </button>

                <span class="easyedu-guide-modal__step-count">
                    <span class="easyedu-guide-modal__step-count-long" data-easyedu-guide-progress-label data-progress-label="{{guidesteplabel}}">1/{{slidecount}}</span>
                    <span class="easyedu-guide-modal__step-count-compact" data-easyedu-guide-progress-label data-progress-label="__current__ / __total__">1 / {{slidecount}}</span>
                </span>
                </div>
                {{#discoverypresentation}}
                {{! GS10: the slide's Show command docks here, left of Previous/Next. }}
                <div class="easyedu-guide-interface-cue" data-easyedu-guide-interface-cue-action hidden></div>
                {{/discoverypresentation}}
                <div class="easyedu-guide-modal__footer-actions">
                    <button type="button" class="btn btn-outline-secondary" data-easyedu-guide-previous="1">{{guidepreviouslabel}}</button>
                    <button type="button" class="btn btn-primary" data-easyedu-guide-next="1">{{guidenextlabel}}</button>
                </div>
            </footer>
        </div>
    </div>

    <aside class="easyedu-guide-interface-return" data-easyedu-guide-interface-return hidden role="status" aria-live="polite" aria-atomic="true" aria-label="{{guidereturnlabel}}">
        <div class="easyedu-guide-interface-return__text">
            <strong>{{guidereturnlabel}}</strong>
            <span>{{guidereturndesc}}</span>
        </div>
        <div class="easyedu-guide-interface-return__actions">
            <button type="button" class="btn btn-primary btn-sm easyedu-guide-interface-return__button" data-easyedu-guide-interface-return-button="1">
                <span class="fa fa-route" aria-hidden="true"></span>
                <span>{{guidereturnbutton}}</span>
            </button>
            <button
                type="button"
                class="btn btn-outline-secondary btn-sm easyedu-guide-interface-return__dismiss"
                data-easyedu-guide-interface-return-dismiss="1"
                aria-label="{{guidereturndismiss}}"
            >
                <span class="fa fa-times" aria-hidden="true"></span>
            </button>
        </div>
    </aside>
    {{#guidewelcomecopy}}
    <aside class="easyedu-guide-welcome easyedu-v3-banner easyedu-v3-banner--welcome easyedu-v3-banner--anchored" data-easyedu-guide-welcome hidden role="region" aria-label="{{guidewelcometitle}}">
        <span class="easyedu-v3-banner__arrow" aria-hidden="true"></span>
        <div class="easyedu-v3-banner__panel">
            <div class="easyedu-v3-banner__content">
                <span class="easyedu-v3-banner__tile" aria-hidden="true"><span class="fa fa-compass" aria-hidden="true"></span></span>
                <div class="easyedu-v3-banner__heading">
                    <span class="easyedu-v3-banner__eyebrow">{{guidewelcomeeyebrow}}</span>
                    <strong class="easyedu-v3-banner__title">{{guidewelcometitle}}</strong>
                </div>
                <p class="easyedu-v3-banner__text">{{guidewelcomecopy}}</p>
            </div>
            <div class="easyedu-v3-banner__actions">
                <button type="button" class="easyedu-guide-welcome__open easyedu-v3-banner__action" data-easyedu-guide-open>{{guidewelcomeopen}}</button>
                <button type="button" class="easyedu-guide-welcome__dismiss easyedu-v3-banner__action easyedu-v3-banner__action--secondary" data-easyedu-guide-welcome-dismiss>{{guidewelcomedismiss}}</button>
            </div>
        </div>
    </aside>
    {{/guidewelcomecopy}}
    <aside class="easyedu-guide-resume" data-easyedu-guide-resume hidden role="status" aria-live="polite" aria-atomic="true" aria-label="{{guideresumetitle}}">
        <span>{{guideresumetitle}}</span>
        <button type="button" class="btn btn-primary" data-easyedu-guide-resume-path>{{guideresumelabel}}</button>
        <button type="button" class="btn btn-outline-secondary" data-easyedu-guide-cancel-path>{{guidecancelpathlabel}}</button>
    </aside>

    <aside class="easyedu-guide-checklist easyedu-guided-panel" data-easyedu-guide-checklist hidden role="region" aria-label="{{guidechecklisttitle}}">
        <div class="easyedu-guide-checklist__header easyedu-guided-panel__header">
            <div>
                <strong data-easyedu-guide-checklist-title>{{guidechecklisttitle}}</strong>
                <span data-easyedu-guide-checklist-subtitle>{{guideguidedpathlabel}}</span>
            </div>
            <span class="easyedu-guided-panel__done fa fa-check" aria-hidden="true"></span>
            <div class="easyedu-guided-panel__header-actions">
                <button type="button" class="btn btn-link easyedu-guided-panel__minimize" data-easyedu-guide-checklist-minimize="1" aria-label="{{guideminimizelabel}}" aria-expanded="true">
                    <span class="fa fa-minus" aria-hidden="true"></span>
                </button>
                {{#discoverypresentation}}<button type="button" class="btn btn-outline-secondary easyedu-guided-panel__restore" data-easyedu-guide-checklist-restore="1" aria-expanded="false" hidden><span class="fa fa-expand" aria-hidden="true"></span><span class="sr-only">{{guiderestorelabel}}</span></button>{{/discoverypresentation}}
                <button type="button" class="btn btn-link easyedu-guided-panel__close" data-easyedu-guide-checklist-close="1" aria-label="{{guidecloselabel}}">
                    {{#discoverypresentation}}<span aria-hidden="true">&times;</span>{{/discoverypresentation}}
                    {{^discoverypresentation}}<span class="fa fa-times" aria-hidden="true"></span>{{/discoverypresentation}}
                </button>
            </div>
        </div>
        <div class="easyedu-guide-checklist__items easyedu-guided-panel__steps" data-easyedu-guide-checklist-items></div>
        <div
            class="easyedu-guide-checklist__complete easyedu-guided-panel__message"
            data-easyedu-guide-checklist-message
            data-complete-message="Everything is set"
            role="status"
            aria-live="polite"
            aria-atomic="true"
        >
            <span class="fa fa-location-arrow" aria-hidden="true"></span>
            <span data-easyedu-guide-checklist-message-text>Everything is set</span>
            <span class="easyedu-guided-panel__message-compact" aria-hidden="true">Everything is set</span>
        </div>
        <div class="easyedu-guided-panel__footer">
            <button type="button" class="easyedu-direct-icon" data-easyedu-display-open
                data-easyedu-display-tooltip
                aria-label="{{displaypreferenceslabel}}">
                <span class="fa fa-sliders" aria-hidden="true"></span>
                <span class="sr-only">{{displaypreferenceslabel}}</span>
            </button>
            <button type="button" class="btn btn-outline-primary btn-sm easyedu-guided-panel__return" data-easyedu-guide-checklist-return="1">
                <span class="fa fa-route" aria-hidden="true"></span>
                <span>{{guidechecklistreturnlabel}}</span>
            </button>
            {{! TRI n°2: once this guided path is complete, restart it from step 1 (Kit secondary button, same replay icon as the demo). }}
            <button type="button" class="btn btn-outline-secondary btn-sm easyedu-guided-panel__restart" data-easyedu-guide-checklist-restart="1">
                <span class="fa fa-rotate-right" aria-hidden="true"></span>
                <span>{{guidechecklistrestartlabel}}</span>
            </button>
            {{! K19-03: the end box "Close" button duplicated the Kit cross in the header; the cross alone now closes the panel. }}
        </div>
    </aside>
</div>
