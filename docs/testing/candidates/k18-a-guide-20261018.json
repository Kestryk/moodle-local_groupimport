        "   await page.evaluate(()=>{window.k18ObservedClicks=[];const trigger=document.querySelector('[data-guide-loupe-trigger]');if(!trigger.k18OriginalAnimate){trigger.k18OriginalAnimate=trigger.animate;trigger.animate=function(frames,timing){window.k18ObservedClicks.push(frames);return this.k18OriginalAnimate(frames,timing);};}});",
        "   const launch=await measure();await start.click();await page.waitForFunction(()=>document.querySelector('[data-guide-loupe]')?.dataset.guideLoupeState==='done',null,{timeout:30000});",
        "   await page.mouse.move(0,0);await start.evaluate(async n=>{await Promise.all(n.getAnimations().filter(x=>Number.isFinite(x.effect.getTiming().iterations)).map(x=>x.finished.catch(()=>{})));});",
        "   const replay=await measure(),clickFrames=await page.evaluate(()=>window.k18ObservedClicks);",
        "   r.demos.push({phase,language,width,level,kind:'loupe',launch,replay,clickFrames});fs.appendFileSync(out+'/native-loupe-v4-progress.log',JSON.stringify({phase,language,width,level,demos:r.demos.length})+'\\n');",
        "   if(phase==='after'){assert.equal(replay.background,launch.background);assert.equal(replay.height,launch.height);for(const paint of[launch,replay])for(const key of['centreX','centreY','iconCentreY'])assert.ok(Math.abs(paint[key])<=.5,'Loupe '+key+' centred within0.5px');assert.equal(clickFrames.some(frames=>frames.some(f=>f.transform==='scale(.94)')),level==='full','Only full Motion paints the shared rebound');}",
        "  }",
        " }",
        " await context.close();",
        "}",
        "assert.equal(r.errors.length,0);r.passed=true;",
        "}catch(e){r.failure=e.stack;if(page&&!page.isClosed())await page.screenshot({path:out+'/failure-loupe-v4.png',timeout:10000}).catch(()=>{});",
        "}finally{if(browser)await browser.close();if(created)r.cleanup=JSON.parse(cp.execFileSync('${PHP_BINARY}',[out+'/fixture.php','cleanup'],{encoding:'utf8'}));if(lease){ps('Release-EasyEduResourceLease.ps1',['-Resource','moodle51-perf','-RunId',runId]);r.leaseReleased=true;}fs.writeFileSync(out+'/native-loupe-v4.json',JSON.stringify(r,null,2));console.log(JSON.stringify({passed:r.passed,checklists:r.checklists.length,demos:r.demos.length,errors:r.errors,failure:r.failure,cleanup:r.cleanup,leaseReleased:r.leaseReleased}));}})();"
      ]
    },
    "native-phone.cjs": {
      "sha256": "70fe82338e3dbd3a7756dd1c16c0546001b047e6f0eb67bf534a2a1d5da163a5",
      "lines": [
        "const fs=require('node:fs'),cp=require('node:child_process'),assert=require('node:assert/strict');",
        "const {chromium}=require('${PLAYWRIGHT_MODULE}');",
        "const root='${EASYSTUD_SOURCE_ROOT}',out=__dirname,runId='codex1-k18-a-phone';",
        "const ps=(f,a)=>cp.execFileSync('powershell.exe',['-NoProfile','-File','${PLATFORM_ORCHESTRATION_ROOT}/'+f,...a],{encoding:'utf8'});",
        "const read=p=>fs.readFileSync(p,'utf8').replace(/\\r\\n/g,'\\n');",
        "const instrument=text=>text.replace('return {\\n  destroy: destroy,','return {\\n  __test: {setActiveSlide, playDiscoveryScene, renderChecklist, dockChecklistAwayFromTarget, syncChecklistMinimizeControl, setActiveChecklistStep, closeModal, openModal, resolveStepHighlightTarget},\\n  destroy: destroy,');",
        "const css=text=>text.replace(/url\\(([\"']?)(\\.\\.?\\/[^)\"']+)\\1\\)/g,(_,q,p)=>'url(\"'+new URL(p,'${MOODLE_URL}/local/groupimport/styles/student-management.css').href+'\")');",
        "(async()=>{const r={passed:false,errors:[],checklists:[],demos:[],scope:{runtimeFilesChanged:false,checklists:'Every configured path/step content; a real page target forces the same avoidance collision for all rows. This is layout proof, not a business-path replay.',narration:'Reading delays accelerated through supported configuration; animation clocks unchanged.'}};let browser,lease=false,created=false,page;",
        "try{",
        "ps('Acquire-EasyEduResourceLease.ps1',['-Resource','moodle51-perf','-ProjectNamespace','easystud','-RunId',runId,'-Repository',root,'-Purpose','K18-A actual Guide before/after controls, restored fixture, browser-only candidate','-LeaseSeconds','1800','-OwnerPid',String(process.pid)]);lease=true;",
        "const ids=JSON.parse(cp.execFileSync('${PHP_BINARY}',[out+'/fixture.php','create'],{encoding:'utf8'}));created=true;",
        "browser=await chromium.launch({headless:true,executablePath:'${CHROME_BINARY}'});",
        "const lanes=await Promise.allSettled(['fr','en'].map(async language=>{for(const width of [390]){",
        " const context=await browser.newContext({storageState:'${MOODLE_PERF_ROOT}/local/recette-r6-20261017/auth.json',viewport:{width,height:844},hasTouch:width<1024});",
        " const page=await context.newPage();page.setDefaultTimeout(20000);page.on('pageerror',e=>r.errors.push(e.message));page.on('console',m=>{if(m.type()==='error')r.errors.push(m.text());});",
        " await page.goto('${MOODLE_URL}/local/groupimport/manage.php?id='+ids.courseid+'&lang='+language,{waitUntil:'domcontentloaded',timeout:180000});",
        " await page.waitForFunction(()=>{const r=document.querySelector('#local-groupimport-easystud');return r?.dataset.easystudManagerInitialised==='1'&&!r.classList.contains('local-groupimport-easystud--booting')&&r.getAttribute('data-easystud-loading-state')==='ready';},null,{timeout:180000});",
        " await page.waitForFunction(()=>document.querySelector('[data-easyedu-guide-root]')?.easyeduGuideConfig,null,{timeout:180000});",
        " await page.evaluate(()=>{document.querySelectorAll('link[rel=\"stylesheet\"]').forEach(n=>{if(/\\/local\\/groupimport\\/styles\\//.test(n.href))n.disabled=true;});window.k18OriginalSlide=document.querySelector('[data-easyedu-guide-slide=\"2\"]').innerHTML;window.k18OriginalConfig=document.querySelector('[data-easyedu-guide-root]').easyeduGuideConfig;});",
        " const style=await page.addStyleTag({content:css(read(out+'/before-student-management.css'))});",
        " for(const phase of ['before','after']){",
        "  await style.evaluate((n,t)=>{n.textContent=t;},css(read(phase==='before'?out+'/before-student-management.css':root+'/styles/student-management.css')));",
        "  await page.evaluate(()=>document.fonts.ready);",
        "  const engine=instrument(read(phase==='before'?out+'/before-easyedu_guide.js':root+'/amd/src/easyedu_guide.js'));",
        "  const motion=phase==='after'?read(root+'/amd/build/motion.min.js'):null;",
        "  await page.evaluate(async({engine,motion,phase,slide})=>{",
        "    const [old,originalMotion,bubble]=await new Promise(resolve=>require(['local_groupimport/easyedu_guide','local_groupimport/motion','local_groupimport/easyedu_bubble'],(...args)=>resolve(args)));",
        "    const node=document.querySelector('[data-easyedu-guide-root]');(window.k18API||old).destroy(node);",
        "    document.querySelector('[data-easyedu-guide-slide=\"2\"]').innerHTML=phase==='after'?new DOMParser().parseFromString(slide,'text/html').querySelector('[data-easyedu-guide-slide=\"2\"]').innerHTML:window.k18OriginalSlide;",
        "    let m=originalMotion;",
        "    if(motion){m={};new Function('define',motion)((...args)=>{const factory=args.at(-1);factory(m);});}",
        "    window.k18Feedback=[];",
        "    if(m.clickFeedback){const actual=m.clickFeedback;m.clickFeedback=(element,options)=>{window.k18Feedback.push({tag:element?.tagName,marker:[...element?.attributes||[]].filter(a=>a.name.startsWith('data-guide-')).map(a=>[a.name,a.value]),level:options?.level||m.getLevel?.(element)});return actual(element,options);};}",
        "    new Function('define',engine)((deps,factory)=>{window.k18API=factory(m,bubble);});",
        "    const config={...window.k18OriginalConfig,welcomeOffer:false,firstVisit:false,storageKey:window.k18OriginalConfig.storageKey+'.k18probe',narrationMinimumMs:1,narrationMaximumMs:1,narrationWordsPerMinute:100000,narrationLeadInMs:1};",
        "    window.k18API.init(node,config);window.k18Config=node.easyeduGuideConfig;",
        "  },{engine,motion,phase,slide:read(out+'/candidate-slide3-'+language+'.html')});",
        "  // Use the real restoration button and real checklist markup for every configured content variant.",
        "  if(width<1024){",
        "   const rows=await page.evaluate(async()=>{",
        "    const root=document.querySelector('[data-easyedu-guide-root]'),api=window.k18API.__test,config=window.k18Config,target=document.querySelector('#local-groupimport-easystud'),rows=[];",
        "    api.closeModal(root,false,false,{immediate:true});",
        "    for(const [path,steps]of Object.entries(config.paths))for(let index=0;index<steps.length;index++){",
        "     root.easyeduGuideChecklistExpandedTarget=null;",
        "     api.renderChecklist(root,config,path);",
        "     api.setActiveChecklistStep(root,config,index);",
        "     const panel=root.querySelector('[data-easyedu-guide-checklist]');",
        "     panel.classList.remove('is-minimized','is-avoiding');panel.setAttribute('data-easyedu-guide-checklist-expanded','');",
        "     root.easyeduGuideCurrentTarget=target;",
        "     api.dockChecklistAwayFromTarget(root,target);api.syncChecklistMinimizeControl(root);",
        "     const folded=panel.classList.contains('is-minimized'),restore=root.querySelector('[data-easyedu-guide-checklist-restore]');",
        "     const button=restore.getBoundingClientRect(),hit=document.elementFromPoint(button.x+button.width/2,button.y+button.height/2);const hitRestore=button.width>0&&button.height>0&&!!hit&&restore.contains(hit);if(!hitRestore)throw Error('Actual phone restore button is obstructed');const old=panel.getBoundingClientRect();restore.click();",
        "     await new Promise(resolve=>requestAnimationFrame(()=>requestAnimationFrame(resolve)));",
        "     const rect=panel.getBoundingClientRect();",
        "     rows.push({path,index,id:steps[index].id,activeIndex:Number(panel.querySelector('[aria-current=\"step\"]').dataset.easyeduGuideStepIndex),steps:steps.length,hitRestore,folded,restored:!panel.classList.contains('is-minimized'),heightBefore:old.height,heightAfter:rect.height,width:rect.width,restoreExpanded:restore.getAttribute('aria-expanded'),withinViewport:rect.top>=-0.5&&rect.bottom<=innerHeight+0.5});",
        "    }return rows;",
        "   });r.checklists.push(...rows.map(row=>({phase,language,width,...row})));",
        "   if(phase==='after')assert.ok(rows.every(row=>row.folded&&row.restored&&row.activeIndex===row.index&&row.heightAfter>row.heightBefore+1),'Every path/step checklist can be restored after automatic avoidance');",
        "  }",
        "",
        " }",
        " await context.close();",
        "}}));",
        "const failed=lanes.filter(l=>l.status==='rejected');if(failed.length)throw failed[0].reason;",
        "assert.equal(r.checklists.length,120);assert.ok(r.checklists.filter(row=>row.phase==='after').every(row=>row.withinViewport),'Expanded phone checklists stay in the real844px viewport');",
        "assert.ok(r.checklists.some(row=>row.phase==='before'&&row.folded&&!row.restored),'The original manual-restore regression was reproduced');assert.equal(r.errors.length,0);r.passed=true;",
        "}catch(e){r.failure=e.stack;if(page&&!page.isClosed())await page.screenshot({path:out+'/failure-phone.png',timeout:10000}).catch(()=>{});",
        "}finally{if(browser)await browser.close();if(created)r.cleanup=JSON.parse(cp.execFileSync('${PHP_BINARY}',[out+'/fixture.php','cleanup'],{encoding:'utf8'}));if(lease){ps('Release-EasyEduResourceLease.ps1',['-Resource','moodle51-perf','-RunId',runId]);r.leaseReleased=true;}fs.writeFileSync(out+'/native-phone.json',JSON.stringify(r,null,2));console.log(JSON.stringify({passed:r.passed,checklists:r.checklists.length,demos:r.demos.length,errors:r.errors,failure:r.failure,cleanup:r.cleanup,leaseReleased:r.leaseReleased}));}})();"
      ]
    },
    "fixture.php": {
      "sha256": "9b6a26098bef7c7bd4e5f78096b14da2dd18ffe3b2648b77c09e4a93babf5f03",
      "lines": [
        "<?php",
        "define('CLI_SCRIPT', true);",
        "require('${MOODLE_PERF_ROOT}/config.php');",
        "require_once($CFG->dirroot . '/course/lib.php');",
        "require_once($CFG->dirroot . '/group/lib.php');",
        "require_once($CFG->dirroot . '/user/lib.php');",
        "require_once($CFG->libdir . '/enrollib.php');",
        "$marker = 'codex1-k18-a-guide';",
        "$record = __DIR__ . '/fixture-ids.json';",
        "if (($argv[1] ?? '') === 'create') {",
        "    if (file_exists($record)) {",
        "        $previous = json_decode(file_get_contents($record));",
        "        $restored = json_decode(file_get_contents(__DIR__ . '/fixture-restored.json'));",
        "        if (!$restored->removed || $previous->courseid !== $restored->courseid ||",
        "                $DB->record_exists('course', ['id' => $previous->courseid])) {",
        "            throw new Exception('Existing fixture has not been restored; reconcile before creating.');",
        "        }",
        "        copy($record, __DIR__ . '/fixture-ids-' . $previous->courseid . '.json');",
        "    }",
        "    $category = $DB->get_record_sql('SELECT id FROM {course_categories} ORDER BY id', null, IGNORE_MULTIPLE);",
        "    $course = create_course((object)['category' => $category->id, 'shortname' => $marker,",
        "        'fullname' => 'Kit menu recipe isolated', 'idnumber' => $marker, 'visible' => 0]);",
        "    $ids = ['courseid' => $course->id, 'marker' => $marker, 'users' => []];",
        "    file_put_contents($record, json_encode($ids));",
        "    $groups = [];",
        "    foreach (['Alpha', 'Beta', 'Gamma', 'Delta', 'Epsilon'] as $suffix) {",
        "        $groups[] = groups_create_group((object)['courseid' => $course->id, 'name' => 'Kit ' . $suffix]);",
        "    }",
        "    $grouping = groups_create_grouping((object)['courseid' => $course->id, 'name' => 'Kit container']);",
        "    groups_assign_grouping($grouping, $groups[0]);",
        "    groups_assign_grouping($grouping, $groups[2]);",
        "    groups_assign_grouping($grouping, $groups[3]);",
        "    groups_assign_grouping($grouping, $groups[4]);",
        "    $manual = enrol_get_plugin('manual');",
        "    $instance = $DB->get_record('enrol', ['courseid' => $course->id, 'enrol' => 'manual']);",
        "    if (!$instance) {",
        "        $instanceid = $manual->add_instance($course);",
        "        $instance = $DB->get_record('enrol', ['id' => $instanceid], '*', MUST_EXIST);",
        "    }",
        "    $roleid = $DB->get_field('role', 'id', ['archetype' => 'student'], MUST_EXIST);",
        "    foreach (['One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine', 'Ten', 'Eleven', 'Twelve'] as $index => $suffix) {",
        "        $username = 'k1680_' . $course->id . '_' . $index;",
        "        $userid = user_create_user((object)['username' => $username, 'firstname' => 'Kit', 'lastname' => $suffix,",
        "            'email' => $username . '@example.invalid', 'auth' => 'manual', 'confirmed' => 1,",
        "            'idnumber' => $marker, 'password' => 'Rand!9' . random_string(24)]);",
        "        $ids['users'][] = $userid;",
        "        file_put_contents($record, json_encode($ids));",
        "        $manual->enrol_user($instance, $userid, $roleid);",
        "        groups_add_member($groups[0], $userid);",
        "    }",
        "    echo json_encode(['created' => true, 'courseid' => $course->id]);",
        "} else if (($argv[1] ?? '') === 'cleanup') {",
        "    $fixture = json_decode(file_get_contents($record));",
        "    $course = $DB->get_record('course', ['id' => $fixture->courseid, 'idnumber' => $marker], '*', MUST_EXIST);",
        "    ob_start();",
        "    delete_course($course, false);",
        "    foreach ($fixture->users ?? [] as $userid) {",
        "        $user = $DB->get_record('user', ['id' => $userid, 'idnumber' => $marker], '*', MUST_EXIST);",
        "        delete_user($user);",
        "    }",
        "    ob_end_clean();",
        "    $removed = !$DB->record_exists('course', ['id' => $fixture->courseid]);",
        "    $usersremoved = !$DB->record_exists('user', ['idnumber' => $marker, 'deleted' => 0]);",
        "    file_put_contents(__DIR__ . '/fixture-restored.json', json_encode(['removed' => $removed, 'usersRemoved' => $usersremoved, 'courseid' => $fixture->courseid]));",
        "    echo json_encode(['removed' => $removed, 'usersRemoved' => $usersremoved]);",
        "} else {",
        "    throw new Exception('Expected create or cleanup.');",
        "}"
      ]
    }
  }
