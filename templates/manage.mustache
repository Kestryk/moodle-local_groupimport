<div
    class="local-groupimport-easystud local-groupimport-easystud--booting{{#compactparticipantsdefault}} local-groupimport-easystud--compact-users{{/compactparticipantsdefault}}{{^animationsenabled}} is-easyedu-motion-off{{/animationsenabled}}"
    id="local-groupimport-easystud"
    data-easystud-loading-state="loading"
    data-easystud-course-id="{{courseid}}"
    data-easystud-action-busy-label="{{actioninprogress}}"
    data-easystud-detail-labels="{{detaillabelsjson}}"
    data-easystud-mobile-card-actions="{{mobilecardactions}}"
    data-easyedu-motion-policy="{{motionpolicy}}"
    data-easystud-loading-reveal-duration="320"
>
    <div class="local-groupimport-easystud__loading-skeleton" data-easystud-loading-skeleton="1" data-easyedu-navigation-skeleton="1" aria-hidden="true">
        <div class="local-groupimport-easystud__loading-header">
            <span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-header-eyebrow"></span>
            <span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-header-title"></span>
            <span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-header-intro"></span>
            <div class="local-groupimport-easystud__loading-header-actions">
                <span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-header-action"></span>
                <span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-header-action"></span>
            </div>
        </div>

        <div class="local-groupimport-easystud__loading-navigation" aria-hidden="true">
            <div class="local-groupimport-easystud__loading-navigation-frame">
                <span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-navigation-guide"></span>
                <div class="local-groupimport-easystud__loading-navigation-cues">
                    <span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-navigation-cue"></span>
                </div>
            </div>
        </div>

        <div class="local-groupimport-easystud__loading-view-toggle">
            <span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-view-toggle-item"></span>
            <span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-view-toggle-item"></span>
            <span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-view-toggle-item"></span>
        </div>

        <div class="local-groupimport-easystud__loading-layout">
            <div class="local-groupimport-easystud__loading-panel local-groupimport-easystud__loading-panel--participants">
                <div class="local-groupimport-easystud__loading-panel-header">
                    <span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-panel-title"></span>
                    <span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-panel-secondary"></span>
                </div>

                <div class="local-groupimport-easystud__loading-search-filter-region">
                    <span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-search"></span>
                    <span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-filter-cluster"></span>
                </div>

                <div class="local-groupimport-easystud__loading-pagination">
                    <span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-pagination-summary"></span>
                    <span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-pagination-rail"></span>
                </div>

                <div class="local-groupimport-easystud__loading-participant-list">
                    <div class="local-groupimport-easystud__loading-participant-card"><span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-card-copy"></span></div>
                    <div class="local-groupimport-easystud__loading-participant-card"><span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-card-copy"></span></div>
                    <div class="local-groupimport-easystud__loading-participant-card"><span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-card-copy"></span></div>
                    <div class="local-groupimport-easystud__loading-participant-card"><span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-card-copy"></span></div>
                    <div class="local-groupimport-easystud__loading-participant-card"><span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-card-copy"></span></div>
                    <div class="local-groupimport-easystud__loading-participant-card"><span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-card-copy"></span></div>
                    <div class="local-groupimport-easystud__loading-participant-card"><span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-card-copy"></span></div>
                    <div class="local-groupimport-easystud__loading-participant-card"><span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-card-copy"></span></div>
                    <div class="local-groupimport-easystud__loading-participant-card"><span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-card-copy"></span></div>
                    <div class="local-groupimport-easystud__loading-participant-card"><span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-card-copy"></span></div>
                    <div class="local-groupimport-easystud__loading-participant-card"><span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-card-copy"></span></div>
                    <div class="local-groupimport-easystud__loading-participant-card"><span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-card-copy"></span></div>
                    <div class="local-groupimport-easystud__loading-participant-card"><span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-card-copy"></span></div>
                    <div class="local-groupimport-easystud__loading-participant-card"><span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-card-copy"></span></div>
                    <div class="local-groupimport-easystud__loading-participant-card"><span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-card-copy"></span></div>
                    <div class="local-groupimport-easystud__loading-participant-card"><span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-card-copy"></span></div>
                    <div class="local-groupimport-easystud__loading-participant-card"><span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-card-copy"></span></div>
                    <div class="local-groupimport-easystud__loading-participant-card"><span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-card-copy"></span></div>
                    <div class="local-groupimport-easystud__loading-participant-card"><span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-card-copy"></span></div>
                    <div class="local-groupimport-easystud__loading-participant-card"><span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-card-copy"></span></div>
                </div>
            </div>

            <div class="local-groupimport-easystud__loading-panel local-groupimport-easystud__loading-panel--structure">
                <div class="local-groupimport-easystud__loading-panel-header">
                    <span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-panel-title"></span>
                    <span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-panel-secondary"></span>
                </div>
                <div class="local-groupimport-easystud__loading-structure-tools">
                    <span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-search"></span>
                    <span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-filter-cluster"></span>
                </div>
                <div class="local-groupimport-easystud__loading-structure-list">
                    <div class="local-groupimport-easystud__loading-structure-card"><span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-card-copy"></span></div>
                    <div class="local-groupimport-easystud__loading-structure-card"><span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-card-copy"></span></div>
                    <div class="local-groupimport-easystud__loading-structure-card"><span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-card-copy"></span></div>
                    <div class="local-groupimport-easystud__loading-structure-card"><span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-card-copy"></span></div>
                    <div class="local-groupimport-easystud__loading-structure-card"><span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-card-copy"></span></div>
                    <div class="local-groupimport-easystud__loading-structure-card"><span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-card-copy"></span></div>
                    <div class="local-groupimport-easystud__loading-structure-card"><span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-card-copy"></span></div>
                    <div class="local-groupimport-easystud__loading-structure-card"><span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-card-copy"></span></div>
                    <div class="local-groupimport-easystud__loading-structure-card"><span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-card-copy"></span></div>
                    <div class="local-groupimport-easystud__loading-structure-card"><span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-card-copy"></span></div>
                </div>
            </div>
        </div>
    </div>
    <noscript>
        <style>
            #local-groupimport-easystud [data-easystud-loading-skeleton] { display: none !important; }
            #local-groupimport-easystud [data-easystud-real-content] { display: block !important; }
        </style>
    </noscript>
    <div class="local-groupimport-easystud__content" data-easystud-real-content="1">
    <div class="local-groupimport-easystud__notifications" data-easystud-notifications="1" aria-live="polite"></div>
    <div class="local-groupimport-easystud-action-status" data-easystud-action-busy-status="1" role="status" aria-live="polite" hidden>
        <span class="local-groupimport-easystud-action-status__spinner" aria-hidden="true"></span>
        <span data-easystud-action-busy-text>{{actioninprogress}}</span>
    </div>
    {{^useeasyeduguide}}
    <div class="local-groupimport-easystud-discovery" data-easystud-discovery="1" hidden>
        <div class="local-groupimport-easystud-discovery__icon">
            <span class="fa fa-compass" aria-hidden="true"></span>
        </div>
        <div class="local-groupimport-easystud-discovery__text">
            <strong>{{tutorialdiscovertitle}}</strong>
            <span>{{tutorialdiscovertext}}</span>
        </div>
        <div class="local-groupimport-easystud-discovery__actions">
            <button type="button" class="btn btn-primary btn-sm" data-easystud-discovery-start="1">
                <span class="fa fa-play-circle me-1" aria-hidden="true"></span>
                <span>{{tutorialdiscoverbutton}}</span>
            </button>
            <button
                type="button"
                class="btn btn-outline-secondary btn-sm local-groupimport-easystud-discovery__dismiss"
                data-easystud-discovery-dismiss="1"
                aria-label="{{tutorialdiscoverdismiss}}"
            >
                <span class="fa fa-times" aria-hidden="true"></span>
            </button>
        </div>
    </div>
    {{/useeasyeduguide}}

    <div class="local-groupimport-easystud__header">
        <div>
            <span class="local-groupimport-easystud__eyebrow">{{eyebrow}}</span>
            {{#navigation}}
                {{#hasparticipantdropdown}}
                    <div
                        class="local-groupimport-easystud__participant-navigation"
                        data-easystud-participant-navigation="1"
                    >
                        {{#participantdropdown}}
                            {{> core/select_menu}}
                        {{/participantdropdown}}
                    </div>
                {{/hasparticipantdropdown}}
            {{/navigation}}
            <div class="local-groupimport-easystud__navigation">
                {{#navigation}}
                    {{> local_groupimport/easyedu_navigation}}
                {{/navigation}}
            </div>
            <p class="text-muted mb-0">{{description}}</p>
        </div>
    </div>

    <div class="local-groupimport-easystud__layout-toggles">
        <div class="btn-group local-groupimport-easystud__layout-mode-group" role="group" aria-label="{{selectionmodelabel}}">
            {{#layoutmodetoggles}}
                <button
                    type="button"
                    class="{{class}}"
                    {{{attribute}}}
                >
                    <span class="fa {{icon}}" aria-hidden="true"></span>
                    <span>{{label}}</span>
                </button>
            {{/layoutmodetoggles}}
        </div>
        <div class="local-groupimport-easystud__clear-selection-frame" data-easystud-clear-selection-frame="1" hidden>
            <span class="local-groupimport-easystud__clear-selection-count" data-easystud-clear-selection-count="1"></span>
            <button
                type="button"
                class="btn btn-outline-secondary btn-sm local-groupimport-easystud__clear-selection"
                data-easystud-clear-all-selection="1"
                hidden
            >
                <span class="fa fa-times-circle me-2" aria-hidden="true"></span>
                <span>{{clearselectionlabel}}</span>
            </button>
        </div>
    </div>

    <div
        class="local-groupimport-easystud-mobile-view"
        data-easystud-mobile-view-switcher="1"
        role="group"
        aria-label="{{mobileviewlabel}}"
    >
        <button type="button" data-easystud-mobile-view="participants" aria-pressed="true">
            <span class="fa fa-user" aria-hidden="true"></span>
            <span>{{mobileviewparticipants}}</span>
        </button>
        <button type="button" data-easystud-mobile-view="groups" aria-pressed="false">
            <span class="fa fa-users" aria-hidden="true"></span>
            <span>{{mobileviewgroups}}</span>
        </button>
        <button type="button" data-easystud-mobile-view="groupings" aria-pressed="false">
            <span class="fa fa-layer-group" aria-hidden="true"></span>
            <span>{{mobileviewgroupings}}</span>
        </button>
    </div>

    <div class="local-groupimport-easystud__layout">
        <div class="local-groupimport-easystud__panel local-groupimport-easystud__panel--participants card" data-easystud-participants-panel="1">
            <div class="card-body">
                <div class="local-groupimport-easystud__panel-heading">
                    <div class="local-groupimport-easystud__panel-title-wrap">
                        <h3 class="h5 mb-0 local-groupimport-easystud__panel-title">{{participantstitle}}</h3>
                        <span class="local-groupimport-easystud__panel-badge">{{participantscountlabel}}</span>
                    </div>
                    <div class="local-groupimport-easystud__panel-actions">
                        {{#participantactions}}
                            <button
                                type="button"
                                class="{{class}}"
                                {{{attribute}}}
                                {{#disabled}}disabled{{/disabled}}
                                {{#hidden}}hidden{{/hidden}}
                            >
                                <span class="fa {{icon}}" aria-hidden="true"></span>
                                <span>{{label}}</span>
                            </button>
                        {{/participantactions}}
                    </div>
                </div>

                <div class="local-groupimport-easystud__participant-content" data-easystud-participant-content="1">
                    <div class="local-groupimport-easystud__participant-main" data-easystud-mobile-entity-region="participants">
                        <div class="local-groupimport-easystud__filters" data-easystud-filters="1">
                            <div class="local-groupimport-easystud-column-heading local-groupimport-easystud-column-heading--participants">
                                <span class="local-groupimport-easystud-column-heading__title">{{participantstitle}}</span>
                            </div>
                            <div class="local-groupimport-easystud__search-row">
                                <label class="local-groupimport-easystud__search-field" aria-label="{{searchlabel}}">
                                    <span class="fa fa-search" aria-hidden="true"></span>
                                    <input
                                        type="search"
                                        class="form-control local-groupimport-easystud__search"
                                        placeholder="{{searchplaceholder}}"
                                        data-easystud-search="1"
                                    >
                                </label>
                                <button
                                    type="button"
                                    class="btn btn-outline-secondary btn-sm local-groupimport-easystud__filters-reset"
                                    data-easystud-reset-filters="1"
                                >{{resetfilterslabel}}</button>
                            </div>

                            <div class="local-groupimport-easystud-advanced-filters" data-easystud-advanced-filters="participants">
                                <div class="local-groupimport-easystud__filters-grid">
                                    <div class="local-groupimport-easystud__filter-group local-groupimport-easystud__filter-group--roles">
                                        <span class="local-groupimport-easystud__filter-label">{{rolesfilterlabel}}</span>
                                        <div class="local-groupimport-easystud__role-toggle-wrap" data-easystud-role-toggle-wrap="1">
                                            <div class="local-groupimport-easystud__role-toggle" data-easystud-role-toggle="1">
                                                {{#rolefilterchoices}}
                                                    <button
                                                        type="button"
                                                        class="btn btn-outline-secondary btn-sm"
                                                        data-easystud-role-choice="{{value}}"
                                                        aria-pressed="false"
                                                    >{{label}}</button>
                                                {{/rolefilterchoices}}
                                            </div>
                                            <select
                                                class="form-select custom-select local-groupimport-easystud__role-select"
                                                data-easystud-role-filter="1"
                                                name="rolefilter"
                                                multiple
                                                hidden
                                            >
                                                {{#roleoptions}}
                                                    <option value="{{value}}">{{label}}</option>
                                                {{/roleoptions}}
                                            </select>
                                        </div>
                                    </div>

                                    <div class="local-groupimport-easystud__filter-group local-groupimport-easystud__filter-group--groups">
                                        <label class="local-groupimport-easystud__filter-label" for="local-groupimport-group-filter">{{groupsfilterlabel}}</label>
                                        <select
                                            id="local-groupimport-group-filter"
                                            class="form-select custom-select"
                                            data-easystud-group-filter="1"
                                            name="groupfilter"
                                            multiple
                                        >
                                            {{#groupoptions}}
                                                <option value="{{value}}">{{label}}</option>
                                            {{/groupoptions}}
                                        </select>
                                    </div>

                                    <div class="local-groupimport-easystud__filter-group local-groupimport-easystud__filter-group--groupings local-groupimport-easystud__filter-group--participant-only">
                                        <label class="local-groupimport-easystud__filter-label" for="local-groupimport-grouping-filter">{{groupingsfilterlabel}}</label>
                                        <select
                                            id="local-groupimport-grouping-filter"
                                            class="form-select custom-select"
                                            data-easystud-grouping-filter="1"
                                            name="groupingfilter"
                                            multiple
                                        >
                                            {{#groupingoptions}}
                                                <option value="{{value}}">{{label}}</option>
                                            {{/groupingoptions}}
                                        </select>
                                    </div>
                                </div>
                            </div>
                        <div class="local-groupimport-easystud-advanced-filters__control">
                            <button
                                type="button"
                                class="local-groupimport-easystud-advanced-filters__toggle"
                                data-easystud-advanced-filters-toggle="participants"
                                aria-expanded="false"
                            >
                                <span class="local-groupimport-easystud-advanced-filters__more">{{morefilters}}</span>
                                <span class="fa fa-chevron-down" aria-hidden="true"></span>
                            </button>
                        </div>
                        </div>

                        <div
                            class="local-groupimport-easystud__participant-list"
                            data-easystud-participant-list="1"
                            data-empty-filtered-label="{{noparticipantsstate}}"
                        >
                            {{#participants}}
                                <div
                                    class="local-groupimport-easystud-user"
                                    tabindex="0"
                                    data-easystud-user="1"
                                    data-selectable-type="participant"
                                    data-selectable-id="{{id}}"
                                    data-user-id="{{id}}"
                                    data-user-email="{{email}}"
                                    data-user-detail="{{userdetailjson}}"
                                    data-user-copy-fields="{{usercopyfieldsjson}}"
                                    data-search-text="{{searchtext}}"
                                    data-role-text="{{roletext}}"
                                    data-group-ids="{{groupidscsv}}"
                                    data-grouping-ids="{{groupingidscsv}}"
                                    draggable="true"
                                >
                                    <label class="local-groupimport-easystud-selector" aria-label="{{selectionmodelabel}}">
                                        <input type="checkbox" data-easystud-selector-input="1" tabindex="-1">
                                        <span class="local-groupimport-easystud-selector__ui" aria-hidden="true"></span>
                                    </label>
                                    <div class="local-groupimport-easystud-user__rail">
                                        <div class="local-groupimport-easystud-user__avatar">{{{profileimage}}}</div>
                                    </div>
                                    <div class="local-groupimport-easystud-user__main">
                                        <div class="local-groupimport-easystud-user__headline">
                                            <div class="local-groupimport-easystud-user__headline-main">
                                                <strong class="local-groupimport-easystud-user__name">{{fullname}}</strong>
                                                {{#primarybadge}}
                                                    <span
                                                        class="local-groupimport-easystud-user__primary-badge"
                                                        style="{{style}}"
                                                        title="{{label}}"
                                                    >{{value}}</span>
                                                {{/primarybadge}}
                                            </div>
                                            <span class="local-groupimport-easystud-user__email">{{email}}</span>
                                            <button
                                                type="button"
                                                class="btn btn-link p-0 local-groupimport-easystud-user__detail-button"
                                                data-easystud-open-user="{{id}}"
                                                aria-label="{{viewdetailslabel}}"
                                                data-easystud-hover-help="{{viewdetailslabel}}"
                                            >
                                                <span class="fa fa-eye" aria-hidden="true"></span>
                                            </button>
                                        </div>
                                        <div class="local-groupimport-easystud-user__meta">
                                            {{#rolesmeta}}
                                                <div class="local-groupimport-easystud-user__meta-group local-groupimport-easystud-user__meta-group--inline">
                                                    <span class="local-groupimport-easystud-user__meta-label">{{label}}</span>
                                                    <div class="local-groupimport-easystud-user__meta-tags">
                                                        {{#tokens}}
                                                            <span
                                                                class="{{class}}"
                                                                {{#hidden}}hidden{{/hidden}}
                                                                {{#extra}}data-easystud-extra-tag="1"{{/extra}}
                                                            >{{label}}</span>
                                                        {{/tokens}}
                                                        {{#hasmore}}
                                                                <button
                                                                    type="button"
                                                                    class="btn btn-link p-0 local-groupimport-easystud-tags-toggle local-groupimport-easystud-token"
                                                                    data-easystud-toggle-tags="1"
                                                                    data-more-label="+0"
                                                                    data-less-label="{{showless}}"
                                                            >+0</button>
                                                        {{/hasmore}}
                                                    </div>
                                                </div>
                                            {{/rolesmeta}}
                                            {{#groupsmeta}}
                                                <div class="local-groupimport-easystud-user__meta-group local-groupimport-easystud-user__meta-group--inline">
                                                    <span class="local-groupimport-easystud-user__meta-label">{{label}}</span>
                                                    <div class="local-groupimport-easystud-user__meta-tags">
                                                        {{#tokens}}
                                                            <span
                                                                class="{{class}}"
                                                                {{#hidden}}hidden{{/hidden}}
                                                                {{#extra}}data-easystud-extra-tag="1"{{/extra}}
                                                            >{{label}}</span>
                                                        {{/tokens}}
                                                        {{#hasmore}}
                                                                <button
                                                                    type="button"
                                                                    class="btn btn-link p-0 local-groupimport-easystud-tags-toggle local-groupimport-easystud-token"
                                                                    data-easystud-toggle-tags="1"
                                                                    data-more-label="+0"
                                                                    data-less-label="{{showless}}"
                                                            >+0</button>
                                                        {{/hasmore}}
                                                    </div>
                                                </div>
                                            {{/groupsmeta}}
                                            {{#groupingsmeta}}
                                                <div class="local-groupimport-easystud-user__meta-group local-groupimport-easystud-user__meta-group--inline">
                                                    <span class="local-groupimport-easystud-user__meta-label">{{label}}</span>
                                                    <div class="local-groupimport-easystud-user__meta-tags">
                                                        {{#tokens}}
                                                            <span
                                                                class="{{class}}"
                                                                {{#hidden}}hidden{{/hidden}}
                                                                {{#extra}}data-easystud-extra-tag="1"{{/extra}}
                                                            >{{label}}</span>
                                                        {{/tokens}}
                                                        {{#hasmore}}
                                                                <button
                                                                    type="button"
                                                                    class="btn btn-link p-0 local-groupimport-easystud-tags-toggle local-groupimport-easystud-token"
                                                                    data-easystud-toggle-tags="1"
                                                                    data-more-label="+0"
                                                                    data-less-label="{{showless}}"
                                                            >+0</button>
                                                        {{/hasmore}}
                                                    </div>
                                                </div>
                                            {{/groupingsmeta}}
                                            {{#customfieldsmeta}}
                                                <div class="local-groupimport-easystud-user__meta-group local-groupimport-easystud-user__meta-group--inline">
                                                    <span class="local-groupimport-easystud-user__meta-label">{{label}}</span>
                                                    <div class="local-groupimport-easystud-user__meta-tags">
                                                        {{#tokens}}
                                                            <span
                                                                class="{{class}}"
                                                                {{#hidden}}hidden{{/hidden}}
                                                                {{#extra}}data-easystud-extra-tag="1"{{/extra}}
                                                            >{{label}}</span>
                                                        {{/tokens}}
                                                        {{#hasmore}}
