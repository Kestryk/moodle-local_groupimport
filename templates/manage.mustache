                    class="local-groupimport-easystud-modal__close"
                    data-easystud-close-move-modal="1"
                    aria-label="{{#str}} closebuttontitle, core {{/str}}"
                >
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div
                class="local-groupimport-easystud-modal__body"
                data-move-participants-help="{{movedialogparticipants}}"
                data-move-members-help="{{movedialogmembers}}"
                data-move-groups-help="{{movedialoggroups}}"
                data-move-participants-label="{{movedestinationgroup}}"
                data-move-groups-label="{{movedestinationgrouping}}"
            >
                <p class="text-muted mb-3" data-easystud-move-modal-help="1">{{movedialogparticipants}}</p>
                <label class="form-label" for="local-groupimport-easystud-move-destination" data-easystud-move-modal-label="1">{{movedestinationgroup}}</label>
                <select
                    id="local-groupimport-easystud-move-destination"
                    class="form-select custom-select easyedu-select"
                    data-easystud-move-destination="1"
                ></select>
                <div
                    class="local-groupimport-easystud-tree__empty local-groupimport-easystud-move-modal__empty"
                    data-easystud-move-empty="1"
                    tabindex="-1"
                    hidden
                ></div>
                <label class="easyedu-toggle-check local-groupimport-easystud-move-origin-check" data-easystud-move-origin-wrap="1" hidden>
                    <input type="checkbox" data-easystud-move-remove-origin="1">
                    <span data-easystud-move-origin-label>{{movegroupremoveorigin}}</span>
                </label>
                <div class="local-groupimport-easystud-modal__footer easyedu-dialog-actions">
                    <button type="button" class="easyedu-button easyedu-button--secondary" data-easystud-close-move-modal="1">{{cancellabel}}</button>
                    <button type="button" class="easyedu-button" data-easystud-confirm-move="1">{{moveconfirm}}</button>
                </div>
            </div>
        </div>
    </div>

    <div class="local-groupimport-easystud-context-backdrop" data-easystud-context-backdrop="1" hidden></div>
    <div class="local-groupimport-easystud-context-menu" data-easystud-context-menu="1" hidden role="menu" aria-label="{{mobilecontexttitle}}">
        <div class="local-groupimport-easystud-context-menu__header" data-easystud-context-header="1">
            <strong>{{mobilecontexttitle}}</strong>
            <button type="button" data-easystud-context-close="1" aria-label="{{mobilecontextclose}}">
                <span class="fa fa-times" aria-hidden="true"></span>
            </button>
        </div>
        <div class="local-groupimport-easystud-context-menu__list">
            {{#contextactions}}
                {{#isitem}}{{#item}}
                {{> local_groupimport/sm/context_action }}
                {{/item}}{{/isitem}}
                {{#isseparator}}
                <div class="local-groupimport-easystud-context-menu__separator" role="separator" data-easystud-context-separator="1"></div>
                {{/isseparator}}
                {{#isgroup}}{{#group}}
                <div class="local-groupimport-easystud-context-menu__group" role="none" data-easystud-context-group="{{key}}" data-easystud-contexts="{{contexts}}">
                    <button
                        type="button"
                        role="menuitem"
                        aria-haspopup="menu"
                        aria-expanded="false"
                        data-easystud-context-submenu-toggle="{{key}}"
                        data-easystud-context-label="{{label}}"
                        {{#multilabel}}data-easystud-context-multi-label="{{multilabel}}"{{/multilabel}}
                    >
                        <span class="fa {{icon}}" aria-hidden="true"></span>
                        <span data-easystud-context-text="1">{{label}}</span>
                        <span class="fa fa-chevron-right local-groupimport-easystud-context-menu__chevron" aria-hidden="true"></span>
                    </button>
                    <div class="local-groupimport-easystud-context-menu__submenu" role="menu" hidden data-easystud-context-submenu="{{key}}" aria-label="{{label}}">
                        {{#actions}}
                        {{> local_groupimport/sm/context_action }}
                        {{/actions}}
                    </div>
                </div>
                {{/group}}{{/isgroup}}
            {{/contextactions}}
        </div>
    </div>
    <button
        type="button"
        class="local-groupimport-easystud-back-to-top"
        data-easystud-back-to-top="1"
        aria-label="{{backtotoplabel}}"
        data-easystud-hover-help="{{backtotoplabel}}"
        hidden
    >
        <span class="fa fa-arrow-up" aria-hidden="true"></span>
    </button>
    </div>
</div>
