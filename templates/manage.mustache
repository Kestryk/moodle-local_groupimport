<div
    class="easyedu-ui local-groupimport-easystud local-groupimport-easystud--booting{{#defaultfocusclass}} {{defaultfocusclass}}{{/defaultfocusclass}}{{#compactparticipantsdefault}} local-groupimport-easystud--compact-users{{/compactparticipantsdefault}}{{^animationsenabled}} is-easyedu-motion-off{{/animationsenabled}}"
    id="local-groupimport-easystud"
    style="{{themestyle}}"
    data-easyedu-custom-rails="{{themerailroles}}"
    data-easyedu-dialog-palette="{{themerailroles}}"
    data-easystud-loading-state="loading"
    data-easyedu-loading-frame="1"
    data-easyedu-loading-responsive-query="(max-width: 1024px)"
    data-easyedu-loading-responsive-class="local-groupimport-easystud--responsive-workspace"
    data-easystud-mobile-view-active="{{defaultmobileview}}"
    data-easyedu-loading-recover-late-ready="1"
    data-easystud-course-id="{{courseid}}"
    data-easystud-user-key="{{userkey}}"
    data-easystud-action-busy-label="{{actioninprogress}}"
    data-easystud-drag-moving-label="{{#str}}dragpreviewmoving, local_groupimport{{/str}}"
    data-easystud-detail-labels="{{detaillabelsjson}}"
    data-easystud-mobile-card-actions="{{mobilecardactions}}"
    data-easystud-default-layout-mode="{{defaultlayoutmode}}"
    data-easystud-default-mobile-view="{{defaultmobileview}}"
    data-easyedu-motion-level="{{motionlevel}}"
    data-easyedu-motion-policy="{{motionpolicy}}"
    data-easystud-loading-reveal-duration="320"
>
    <noscript>
        <style>
            #local-groupimport-easystud [data-easystud-real-content] { position: relative !important; visibility: visible !important; }
        </style>
    </noscript>
    <div class="local-groupimport-easystud__content" data-easystud-real-content="1">
    <div class="local-groupimport-easystud__notifications" data-easystud-notifications="1" aria-live="polite"></div>
    <div class="local-groupimport-easystud-action-status" data-easystud-action-busy-status="1" role="status" aria-live="polite" hidden>
        <span class="local-groupimport-easystud-action-status__spinner" aria-hidden="true"></span>
        <span data-easystud-action-busy-text>{{actioninprogress}}</span>
    </div>


    {{!
        K21-51 "Rail-anchor" page structure (EasyEdu standard, see scss/easyedu/components/_rail-anchor.scss):
        floor 1 = navigation band (identity rail only), floor 2 = one main content frame wrapping
        the whole view. K22-09 (Penpot 09.5 "Piste 3"): the frame opens on one head row where the
        view title + description (no eyebrow on desktop) share the line with the view tabs.
        DOM order equals reading and Tab order: rail, title, tabs, content.
    }}
    <div class="local-groupimport-easystud__header easyedu-rail-anchor__band">
        <div class="local-groupimport-easystud__navigation easyedu-rail-anchor__rail">
            {{#navigation}}
                {{> local_groupimport/easyedu_navigation}}
            {{/navigation}}
        </div>
    </div>

    <div class="local-groupimport-easystud__frame easyedu-rail-anchor__frame">
    <div class="local-groupimport-easystud__view-head easyedu-rail-anchor__head-row">
    <div class="easyedu-workspace-identity easyedu-rail-anchor__head">
        {{! The product eyebrow is compact-only: on desktop the rail carries the identity. }}
        <span class="easyedu-workspace-eyebrow easyedu-rail-anchor__compact-eyebrow">{{#str}}easystudlabel, local_groupimport{{/str}}</span>
        {{#navigation}}
            {{#hasparticipantdropdown}}
                <div
                    class="easyedu-workspace-title-control"
                    data-easystud-participant-navigation="1"
                >
                    {{#participantdropdown}}
                        {{> core/select_menu}}
                    {{/participantdropdown}}
                </div>
            {{/hasparticipantdropdown}}
            {{^hasparticipantdropdown}}
                <h2 class="easyedu-workspace-title">{{drawersubtitle}}</h2>
            {{/hasparticipantdropdown}}
        {{/navigation}}
        <p class="easyedu-workspace-description">{{description}}</p>
    </div>
    <div class="local-groupimport-easystud__view-tabs easyedu-rail-anchor__tabs">
        <div class="btn-group local-groupimport-easystud__layout-mode-group easyedu-workspace-view-switcher easyedu-view-tabs" role="group" aria-label="{{selectionmodelabel}}">
            {{#layoutmodetoggles}}
                <button
                    type="button"
                    class="{{class}} easyedu-view-tabs__tab"
                    {{{attribute}}}
                >
                    <span class="fa {{icon}}" aria-hidden="true"></span>
                    <span>{{label}}</span>
                </button>
            {{/layoutmodetoggles}}
        </div>
    </div>
    </div>

    {{! The selection recovery capsule stays a fixed bottom surface: it is not part of the header band. }}
    <div class="local-groupimport-easystud__layout-toggles">
        <div class="local-groupimport-easystud__clear-selection-frame" data-easystud-clear-selection-frame="1" hidden>
            <span class="local-groupimport-easystud__clear-selection-count" data-easystud-clear-selection-count="1"></span>
            <button
                type="button"
                class="btn btn-outline-secondary btn-sm foundation-selection-action easyedu-selection-recovery-action local-groupimport-easystud__clear-selection"
                data-easystud-clear-all-selection="1"
                hidden
            >
                <span class="fa fa-times-circle" aria-hidden="true"></span>
                <span>{{clearselectionlabel}}</span>
            </button>
        </div>
    </div>

    <div
        class="local-groupimport-easystud-mobile-view easyedu-workspace-view-switcher"
        data-easystud-mobile-view-switcher="1"
        role="group"
        aria-label="{{mobileviewlabel}}"
    >
        <button type="button" data-easystud-mobile-view="participants" aria-pressed="true">
            <span class="fa fa-user" aria-hidden="true"></span>
            <span>{{mobileviewparticipants}}</span>
        </button>
        <button type="button" data-easystud-mobile-view="groups" aria-pressed="false">
            <span class="fa fa-users" aria-hidden="true"></span>
            <span>{{mobileviewgroups}}</span>
        </button>
        <button type="button" data-easystud-mobile-view="groupings" aria-pressed="false">
            <span class="fa fa-layer-group" aria-hidden="true"></span>
            <span>{{mobileviewgroupings}}</span>
        </button>
    </div>

    <div class="local-groupimport-easystud__layout">
        <div class="easyedu-workspace-panel local-groupimport-easystud__panel local-groupimport-easystud__panel--participants card" data-easystud-participants-panel="1">
            <div class="card-body">
                <div class="local-groupimport-easystud__panel-heading">
                    <div class="local-groupimport-easystud__panel-title-wrap">
                        <h3 class="easyedu-workspace-panel-title local-groupimport-easystud__panel-title">{{participantstitle}}</h3>
                        <span class="local-groupimport-easystud__panel-badge">{{participantscountlabel}}</span>
                    </div>
                    <div class="local-groupimport-easystud__panel-actions">
                        {{#participantactions}}
                            <button
                                type="button"
                                class="{{class}} foundation-selection-action"
                                {{{attribute}}}
                                {{#disabled}}disabled{{/disabled}}
                                {{#hidden}}hidden{{/hidden}}
                            >
                                <span class="fa {{icon}}" aria-hidden="true"></span>
                                <span>{{label}}</span>
                            </button>
                        {{/participantactions}}
                    </div>
                </div>

                <div class="local-groupimport-easystud__participant-content" data-easystud-participant-content="1">
                    <div class="local-groupimport-easystud__participant-main" data-easystud-mobile-entity-region="participants">
                        <div class="local-groupimport-easystud__filters" data-easystud-filters="1">
                            <div class="local-groupimport-easystud-column-heading local-groupimport-easystud-column-heading--participants">
                                <div class="local-groupimport-easystud__panel-title-wrap">
                                    <h3 class="easyedu-workspace-panel-title local-groupimport-easystud__panel-title">{{participantstitle}}</h3>
                                    <span class="local-groupimport-easystud__panel-badge">{{participantscountlabel}}</span>
                                </div>
                                <div class="local-groupimport-easystud__panel-actions local-groupimport-easystud-column-heading__actions" data-easystud-column-actions="participants"></div>
                            </div>
                            <div class="local-groupimport-easystud__search-row">
                                <label class="local-groupimport-easystud__search-field easyedu-search-field" aria-label="{{searchlabel}}">
                                    <span class="fa fa-search" aria-hidden="true"></span>
                                    <input
                                        type="search"
                                        class="form-control local-groupimport-easystud__search"
                                        data-easystud-search="1"
                                        placeholder="{{searchplaceholder}}"
                                    >
                                </label>

                            </div>

                            <div class="local-groupimport-easystud-advanced-filters is-collapsed" data-easystud-advanced-filters="participants">
                                <div class="local-groupimport-easystud__filters-grid">
                                    <div class="local-groupimport-easystud__filter-group local-groupimport-easystud__filter-group--roles">
                                        <label class="local-groupimport-easystud__filter-label" for="local-groupimport-role-filter">{{rolesfilterlabel}}</label>
                                        <div class="local-groupimport-easystud__role-toggle-wrap" data-easystud-role-toggle-wrap="1">
                                            <div class="local-groupimport-easystud__role-toggle" data-easystud-role-toggle="1">
                                                {{#rolefilterchoices}}
                                                    <button
                                                        type="button"
                                                        class="btn btn-outline-secondary btn-sm foundation-selection-action"
                                                        data-easystud-role-choice="{{value}}"
                                                        aria-pressed="false"
                                                    ><span>{{label}}</span></button>
                                                {{/rolefilterchoices}}
                                            </div>
                                            <select
                                                id="local-groupimport-role-filter"
                                                class="form-select custom-select local-groupimport-easystud__role-select"
                                                data-easystud-role-filter="1"
                                                name="rolefilter"
                                                multiple
                                                hidden
                                            >
                                                {{#roleoptions}}
                                                    <option value="{{value}}">{{label}}</option>
                                                {{/roleoptions}}
                                            </select>
                                        </div>
                                    </div>

                                    <div class="local-groupimport-easystud__filter-group local-groupimport-easystud__filter-group--groups">
                                        <label class="local-groupimport-easystud__filter-label" for="local-groupimport-group-filter">{{groupsfilterlabel}}</label>
                                        <select
                                            id="local-groupimport-group-filter"
                                            class="form-select custom-select"
                                            data-easystud-group-filter="1"
                                            name="groupfilter"
                                            multiple
                                        >
                                            {{#groupoptions}}
                                                <option value="{{value}}">{{label}}</option>
                                            {{/groupoptions}}
                                        </select>
                                    </div>

                                    <div class="local-groupimport-easystud__filter-group local-groupimport-easystud__filter-group--groupings">
                                        <label class="local-groupimport-easystud__filter-label" for="local-groupimport-grouping-filter">{{groupingsfilterlabel}}</label>
                                        <select
                                            id="local-groupimport-grouping-filter"
                                            class="form-select custom-select"
                                            data-easystud-grouping-filter="1"
                                            name="groupingfilter"
                                            multiple
                                        >
                                            {{#groupingoptions}}
                                                <option value="{{value}}">{{label}}</option>
                                            {{/groupingoptions}}
                                        </select>
                                    </div>
                                </div>
                            <div class="easyedu-filter-actions"><button
                                    type="button"
                                    class="easyedu-button easyedu-button--secondary easyedu-filter-reset local-groupimport-easystud__filters-reset"
                                    data-easystud-reset-filters="1"
                                >{{resetfilterslabel}}</button></div>
</div>
                        <div class="easyedu-filter-disclosure-row local-groupimport-easystud-advanced-filters__control">
                            <button
                                type="button"
                                class="easyedu-filter-disclosure easyedu-filter-disclosure--capsule local-groupimport-easystud-advanced-filters__toggle"
                                data-easystud-advanced-filters-toggle="participants"
                                aria-expanded="false"
                            >
                                <span class="easyedu-filter-disclosure__content">
                                    <span class="local-groupimport-easystud-advanced-filters__more" data-easystud-more-label="{{morefilters}}" data-easystud-less-label="{{lessfilters}}">{{morefilters}}</span>
                                    <span class="local-groupimport-easystud-advanced-filters__count" data-easystud-advanced-filters-count="participants" aria-hidden="true" hidden></span>
                                    <span class="visually-hidden" data-easystud-advanced-filters-count-text="participants"></span>
                                    <span class="fa fa-chevron-down" aria-hidden="true"></span>
                                </span>
                            </button>
                        </div>
                        </div>

                        <button
                            type="button"
                            class="btn btn-outline-secondary btn-sm foundation-selection-action local-groupimport-easystud__membership-toggle"
                            data-easystud-mobile-membership-toggle="1"
                            aria-pressed="true"
                            hidden
                        >
                            <span class="fa fa-expand" aria-hidden="true"></span>
                            <span></span>
                        </button>
                        <div
                            class="local-groupimport-easystud__participant-list"
                            data-easystud-participant-list="1"
                            data-empty-filtered-label="{{noparticipantsstate}}"
                        >
                            <div class="local-groupimport-easystud__loading-participant-list" data-easystud-sm-loading="participants" aria-hidden="true">
                                <div class="local-groupimport-easystud__loading-participant-card"><span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-card-avatar"></span><span class="local-groupimport-easystud__loading-card-lines"><span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-card-line"></span><span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-card-line local-groupimport-easystud__loading-card-line--secondary"></span></span></div>
                                <div class="local-groupimport-easystud__loading-participant-card"><span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-card-avatar"></span><span class="local-groupimport-easystud__loading-card-lines"><span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-card-line"></span><span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-card-line local-groupimport-easystud__loading-card-line--secondary"></span></span></div>
                                <div class="local-groupimport-easystud__loading-participant-card"><span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-card-avatar"></span><span class="local-groupimport-easystud__loading-card-lines"><span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-card-line"></span><span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-card-line local-groupimport-easystud__loading-card-line--secondary"></span></span></div>
                                <div class="local-groupimport-easystud__loading-participant-card"><span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-card-avatar"></span><span class="local-groupimport-easystud__loading-card-lines"><span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-card-line"></span><span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-card-line local-groupimport-easystud__loading-card-line--secondary"></span></span></div>
                                <div class="local-groupimport-easystud__loading-participant-card"><span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-card-avatar"></span><span class="local-groupimport-easystud__loading-card-lines"><span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-card-line"></span><span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-card-line local-groupimport-easystud__loading-card-line--secondary"></span></span></div>
                                <div class="local-groupimport-easystud__loading-participant-card"><span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-card-avatar"></span><span class="local-groupimport-easystud__loading-card-lines"><span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-card-line"></span><span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-card-line local-groupimport-easystud__loading-card-line--secondary"></span></span></div>
                                <div class="local-groupimport-easystud__loading-participant-card"><span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-card-avatar"></span><span class="local-groupimport-easystud__loading-card-lines"><span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-card-line"></span><span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-card-line local-groupimport-easystud__loading-card-line--secondary"></span></span></div>
                                <div class="local-groupimport-easystud__loading-participant-card"><span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-card-avatar"></span><span class="local-groupimport-easystud__loading-card-lines"><span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-card-line"></span><span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-card-line local-groupimport-easystud__loading-card-line--secondary"></span></span></div>
                            </div>
                        </div>
                    </div>

                    <div class="local-groupimport-easystud-participant-groups" data-easystud-participant-groups-panel="1"{{#participantfocusdefault}} data-easyedu-loading-desktop-reveal="1"{{/participantfocusdefault}} hidden>
                        <div class="local-groupimport-easystud-participant-groups__create">
                            <div class="local-groupimport-easystud-column-heading local-groupimport-easystud-column-heading--participant-groups">
                                <div class="local-groupimport-easystud__panel-title-wrap">
                                    <h3 class="easyedu-workspace-panel-title local-groupimport-easystud__panel-title">{{groupscolumnlabel}}</h3>
                                    <span class="local-groupimport-easystud__panel-badge local-groupimport-easystud__panel-badge--accent" data-easystud-structure-count="groups" data-count-template="{{structuregroupscounttemplate}}">{{structuregroupscountlabel}}</span>
                                </div>
                                <div class="local-groupimport-easystud__panel-actions local-groupimport-easystud-column-heading__actions" data-easystud-column-actions="participant-groups"></div>
                            </div>
                            <div class="local-groupimport-easystud-create-card__topline">
                                <form method="post" action="{{quickcreateurl}}" class="local-groupimport-easystud-create">
                                    <input type="hidden" name="sesskey" value="{{sesskey}}">
                                    <input type="hidden" name="action" value="creategroup">
                                    <label class="easyedu-field-stack"><span class="easyedu-field-caption">{{newgroupplaceholder}}</span><input
                                        type="text"
                                        name="groupname"
                                        class="form-control"
                                        autocomplete="off"
                                    ></label>
                                    <button
                                        type="submit"
                                        class="btn local-groupimport-easystud-icon-button easyedu-create-icon-button"
                                        aria-label="{{creategrouplabel}}"
                                        data-easystud-hover-help="{{creategrouplabel}}"
                                    >
                                        <span class="fa fa-plus" aria-hidden="true"></span>
                                    </button>
                                </form>
                                <label class="local-groupimport-easystud__search-field local-groupimport-easystud__search-field--catalog easyedu-search-field" aria-label="{{searchgroupslabel}}">
                                    <span class="fa fa-search" aria-hidden="true"></span>
                                    <input
                                        type="search"
                                        class="form-control local-groupimport-easystud__search"
                                        data-easystud-catalog-search="participants"
                                        placeholder="{{searchgroupsplaceholder}}"
                                    >
                                </label>
                            </div>
                            <div class="local-groupimport-easystud-advanced-filters is-collapsed" data-easystud-advanced-filters="participant-groups">
                                <div class="local-groupimport-easystud-group-catalog-filters">
                                    <div class="local-groupimport-easystud__filter-group">
                                        <label class="local-groupimport-easystud__filter-label" for="local-groupimport-participant-catalog-grouping-filter">{{groupingsfilterlabel}}</label>
                                        <select
                                            id="local-groupimport-participant-catalog-grouping-filter"
                                            class="form-select custom-select"
                                            data-easystud-catalog-grouping-filter="participants"
                                            multiple
                                            aria-label="{{groupingsfilterlabel}}"
                                        >
                                            {{#groupingoptions}}
                                                <option value="{{value}}">{{label}}</option>
                                            {{/groupingoptions}}
                                        </select>
                                    </div>
                                    <div class="easyedu-filter-actions">
                                        <label class="easyedu-filter-toggle easyedu-filter-toggle--trailing easyedu-filter-toggle--track-focus local-groupimport-easystud-toggle-check">
                                            <input type="checkbox" data-easystud-catalog-show-ungrouped="participants">
                                            <span>{{onlyshowungroupedlabel}}</span>
                                        </label>
                                        <button
                                            type="button"
                                            class="easyedu-button easyedu-button--secondary easyedu-filter-reset local-groupimport-easystud__filters-reset local-groupimport-easystud__filters-reset--catalog"
                                            data-easystud-reset-catalog-filters="participants"
                                        >{{resetfilterslabel}}</button>
                                    </div>
                                </div>
                            </div>
                        <div class="easyedu-filter-disclosure-row local-groupimport-easystud-advanced-filters__control">
                            <button
                                type="button"
                                class="easyedu-filter-disclosure easyedu-filter-disclosure--capsule local-groupimport-easystud-advanced-filters__toggle"
                                data-easystud-advanced-filters-toggle="participant-groups"
                                aria-expanded="false"
                            >
                                <span class="easyedu-filter-disclosure__content">
                                    <span class="local-groupimport-easystud-advanced-filters__more" data-easystud-more-label="{{morefilters}}" data-easystud-less-label="{{lessfilters}}">{{morefilters}}</span>
                                    <span class="local-groupimport-easystud-advanced-filters__count" data-easystud-advanced-filters-count="participant-groups" aria-hidden="true" hidden></span>
                                    <span class="visually-hidden" data-easystud-advanced-filters-count-text="participant-groups"></span>
                                    <span class="fa fa-chevron-down" aria-hidden="true"></span>
                                </span>
                            </button>
                        </div>
                        </div>
                        <div class="local-groupimport-easystud-participant-groups__list">
                            <div class="local-groupimport-easystud__loading-structure-list" data-easystud-sm-loading="groups" aria-hidden="true">
                                <div class="local-groupimport-easystud__loading-structure-card"><span class="local-groupimport-easystud__loading-card-lines"><span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-card-line"></span><span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-card-line local-groupimport-easystud__loading-card-line--secondary"></span></span></div>
                                <div class="local-groupimport-easystud__loading-structure-card"><span class="local-groupimport-easystud__loading-card-lines"><span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-card-line"></span><span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-card-line local-groupimport-easystud__loading-card-line--secondary"></span></span></div>
                                <div class="local-groupimport-easystud__loading-structure-card"><span class="local-groupimport-easystud__loading-card-lines"><span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-card-line"></span><span class="local-groupimport-easystud__loading-surface local-groupimport-easystud__loading-card-line local-groupimport-easystud__loading-card-line--secondary"></span></span></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="easyedu-workspace-panel easyedu-workspace-panel--success local-groupimport-easystud__panel local-groupimport-easystud__panel--structure card" data-easystud-structure-panel="1">
            <div class="card-body">
                <div class="local-groupimport-easystud__panel-heading">
                    <div class="local-groupimport-easystud__panel-title-wrap">
                        <h3 class="easyedu-workspace-panel-title local-groupimport-easystud__panel-title">{{groupstructuretitle}}</h3>
                        <span class="local-groupimport-easystud__panel-badge local-groupimport-easystud__panel-badge--accent"
                            data-easystud-structure-count="groups" data-count-template="{{structuregroupscounttemplate}}">{{structuregroupscountlabel}}</span>
                        <span class="local-groupimport-easystud__panel-badge local-groupimport-easystud__panel-badge--accent"
                            data-easystud-structure-count="groupings" data-count-template="{{structuregroupingscounttemplate}}">{{structuregroupingscountlabel}}</span>
                    </div>
                    <div class="local-groupimport-easystud__panel-actions">
                        {{#groupactions}}
                            <button
                                type="button"
                                class="{{class}} foundation-selection-action"
                                {{{attribute}}}
                                {{#disabled}}disabled{{/disabled}}
                                {{#hidden}}hidden{{/hidden}}
                            >
                                <span class="fa {{icon}}" aria-hidden="true"></span>
                                <span>{{label}}</span>
                            </button>
                        {{/groupactions}}
                    </div>
                </div>

                <div class="local-groupimport-easystud-create-row">
                    <div class="local-groupimport-easystud-create-card local-groupimport-easystud-create-card--group" data-easystud-mobile-entity-region="groups">
                        <div class="local-groupimport-easystud-column-heading local-groupimport-easystud-column-heading--structure">
                            <div class="local-groupimport-easystud__panel-title-wrap">
                                <h3 class="easyedu-workspace-panel-title local-groupimport-easystud__panel-title">{{groupscolumnlabel}}</h3>
                                <span class="local-groupimport-easystud__panel-badge local-groupimport-easystud__panel-badge--accent" data-easystud-structure-count="groups" data-count-template="{{structuregroupscounttemplate}}">{{structuregroupscountlabel}}</span>
                            </div>
