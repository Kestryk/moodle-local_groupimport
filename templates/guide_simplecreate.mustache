{{!
    @template local_groupimport/guide_simplecreate

    Illustration only. J-G4 owns playback; no Moodle command or form submission.
    Context: discovery_simplecreate_* strings prepared by guide_discovery.

    Example context (json):
    {
        "phase1": "Enter a group name",
        "phase2": "Create the group",
        "phase3": "Create a grouping",
        "phase4": "Review the result",
        "groupname": "Workshop A",
        "groupingname": "Morning workshops",
        "renamed": "Workshop Alpha",
        "grouplabel": "Group name",
        "groupplaceholder": "Enter a group name",
        "addlabel": "Create",
        "renamelabel": "Rename group",
        "emptymembers": "No participants yet",
        "groupinglabel": "Grouping name",
        "groupingplaceholder": "Enter a grouping name",
        "emptygroups": "No groups yet",
        "recaptitle": "Steps to remember"
    }
}}
<div data-guide-simplecreate data-guide-stage data-guide-simplecreate-phase="1"
    data-guide-phase-1-label="{{phase1}}" data-guide-phase-2-label="{{phase2}}"
    data-guide-phase-3-label="{{phase3}}" data-guide-phase-4-label="{{phase4}}"
    data-guide-simplecreate-name="{{groupname}}" data-guide-simplecreate-grouping="{{groupingname}}"
    data-guide-simplecreate-renamed="{{renamed}}">
    <div class="easyedu-guide-scene__utilities align-items-end w-100">
        <label class="easyedu-guide-scene__field"><span>{{grouplabel}}</span>
            <input type="text" data-guide-simplecreate-input="group" placeholder="{{groupplaceholder}}"
                value="" readonly tabindex="-1" autocomplete="off">
        </label>
        <button type="button" class="btn btn-primary" data-guide-simplecreate-submit="group"
            aria-label="{{addlabel}}" tabindex="-1" disabled><span class="fa fa-plus" aria-hidden="true"></span></button>
    </div>
    <div class="easyedu-guide-scene__results" data-guide-simplecreate-result="group" hidden>
        <span class="easyedu-guide-scene__card">
            <span class="easyedu-guide-scene__identity fa fa-users" aria-hidden="true"></span>
            <span class="easyedu-guide-scene__card-copy">
                <span class="easyedu-guide-scene__card-title">
                    <strong data-guide-simplecreate-card-name>{{groupname}}</strong>
                    <input type="text" data-guide-simplecreate-rename value="{{groupname}}" readonly tabindex="-1" hidden>
                    <button type="button" class="easyedu-guide-scene__card-edit" data-guide-simplecreate-edit
                        aria-label="{{renamelabel}}" tabindex="-1" disabled><span class="fa fa-pen" aria-hidden="true"></span></button>
                </span>
                <small>{{emptymembers}}</small>
            </span>
        </span>
    </div>
    <div data-guide-simplecreate-grouping-stage hidden>
        <div class="easyedu-guide-scene__utilities align-items-end w-100">
            <label class="easyedu-guide-scene__field"><span>{{groupinglabel}}</span>
                <input type="text" data-guide-simplecreate-input="grouping" placeholder="{{groupingplaceholder}}"
                    value="" readonly tabindex="-1" autocomplete="off">
            </label>
            <button type="button" class="btn btn-primary" data-guide-simplecreate-submit="grouping"
                aria-label="{{addlabel}}" tabindex="-1" disabled><span class="fa fa-plus" aria-hidden="true"></span></button>
        </div>
        <div class="easyedu-guide-scene__results" data-guide-simplecreate-result="grouping" hidden>
            <span class="easyedu-guide-scene__grouping">
                <span class="easyedu-guide-scene__identity fa fa-layer-group" aria-hidden="true"></span>
                <span class="easyedu-guide-scene__card-copy"><strong>{{groupingname}}</strong><small>{{emptygroups}}</small></span>
            </span>
        </div>
    </div>
    <span class="easyedu-guide-scene__cursor" data-guide-cursor hidden aria-hidden="true"><span class="fa fa-mouse-pointer easyedu-guide-scene__cursor-mouse"></span><span class="easyedu-guide-scene__cursor-touch" data-guide-cursor-touch><span class="easyedu-guide-scene__cursor-ripple" data-guide-cursor-ripple></span></span></span>
</div>
<section class="easyedu-guide-scene__recap" data-guide-recap hidden>
    <button type="button" class="easyedu-guide-scene__recap-toggle" data-guide-recap-toggle aria-expanded="true"><strong>{{recaptitle}}</strong><span class="fa fa-chevron-down" aria-hidden="true"></span></button>
    <div class="easyedu-guide-scene__recap-body" data-guide-recap-body>
        <ol class="easyedu-guide-scene__steps">
            <li data-guide-phase="name">{{phase1}}</li>
            <li data-guide-phase="create">{{phase2}}</li>
            <li data-guide-phase="grouping">{{phase3}}</li>
            <li data-guide-phase="rename">{{phase4}}</li>
        </ol>
    </div>
</section>
