{{!
    @template local_groupimport/mass_import_preview

    Mass Import results card body: the row-confirmation preview, the "no
    results yet" placeholder, or the success/error report of a completed
    import. Exactly one of haspreview / isemptystate / hasreport is set.

    Extracted verbatim from index.php (I4, 2026-10-21): the markup below
    reproduces exactly what html_writer used to produce inline.
}}
{{#preview}}<div class="local-groupimport-import-summary"><span class="local-groupimport-import-summary__item local-groupimport-import-summary__item--success easyedu-report-summary--success"><strong>{{rowcount}}</strong> {{{importpreviewrowslabel}}}</span><span class="local-groupimport-import-summary__item local-groupimport-import-summary__item--error"><strong>{{warningcount}}</strong> {{{importpreviewwarningslabel}}}</span></div><form method="post" action="{{{formaction}}}" class="local-groupimport-import-preview" data-preview-total="{{rowstotal}}"><input type="hidden" name="id" value="{{courseid}}" /><input type="hidden" name="sesskey" value="{{sesskey}}" /><input type="hidden" name="confirmimport" value="1" /><input type="hidden" name="previewtoken" value="{{previewtoken}}" /><input type="hidden" name="previewpayload" value="" /><input type="hidden" name="importfilename" value="{{filename}}" /><input type="hidden" name="importhash" value="{{filehash}}" /><div class="local-groupimport-import-preview__notice easyedu-notice"><span class="fa fa-magic" aria-hidden="true"></span><div><strong>{{{importpreviewtitle}}}</strong><p class="mb-0">{{{previewintro}}}</p></div></div>{{#hasprevious}}<div class="local-groupimport-import-preview__reimport-alert"><span class="fa fa-history" aria-hidden="true"></span><p class="mb-0">{{{previouslabel}}}</p></div>{{/hasprevious}}<fieldset class="local-groupimport-import-preview__strategy easyedu-segmented-choice--contained easyedu-choice"><legend class="easyedu-segmented-choice__legend">{{{reimportstrategylabel}}}</legend><div class="easyedu-segmented-choice__body"><div class="easyedu-segmented-choice__label" aria-hidden="true">{{{reimportstrategylabel}}}</div><div class="easyedu-segmented-choice__options"><label class="easyedu-segmented-choice__option"><input type="radio" name="replacepolicy" value="keep" checked="checked" class="easyedu-segmented-choice__input" /><span class="easyedu-segmented-choice__surface"><span class="fa fa-plus" aria-hidden="true"></span><span><strong>{{{reimportkeeptitle}}}</strong><small>{{{reimportkeepdesc}}}</small></span></span></label><label class="easyedu-segmented-choice__option"><input type="radio" name="replacepolicy" value="replace" class="easyedu-segmented-choice__input" /><span class="easyedu-segmented-choice__surface"><span class="fa fa-sync-alt" aria-hidden="true"></span><span><strong>{{{reimportreplacetitle}}}</strong><small>{{{reimportreplacedesc}}}</small></span></span></label></div></div></fieldset><div class="local-groupimport-import-preview__toolbar easyedu-table-toolbar"><div class="local-groupimport-import-preview__bulk-actions"><button type="button" class="easyedu-button easyedu-button--neutral" data-local-groupimport-preview-toggle-all="1" data-select-all-label="{{selectpreviewpagelabel}}" data-deselect-all-label="{{deselectpreviewpagelabel}}" data-select-results-label="{{selectpreviewresultslabel}}" data-deselect-results-label="{{deselectpreviewresultslabel}}">{{{selectpreviewpagelabel}}}</button></div><label class="local-groupimport-import-preview__search-field easyedu-search" aria-label="{{previewsearchlabel}}"><span class="accesshide">{{{previewsearchlabel}}}</span><span class="fa fa-search" aria-hidden="true"></span><input type="search" class="form-control local-groupimport-import-preview__search" placeholder="{{previewsearchpageonly}}" data-local-groupimport-preview-search="1" /></label></div><div class="local-groupimport-import-preview__table-wrap"><table class="table-reboot easyedu-data-table local-groupimport-import-preview__table"><thead><tr><th>{{{th_include}}}</th><th>{{{th_line}}}</th><th>{{{th_identifier}}}</th><th>{{{th_group}}}</th><th>{{{th_grouping}}}</th><th>{{{th_status}}}</th></tr></thead><tbody>{{#rows}}<tr class="{{rowclass}}" data-local-groupimport-preview-row="1" data-preview-index="{{index}}"><td><input type="checkbox" name="rowenabled[{{index}}]" value="1"{{#checked}} checked="checked"{{/checked}} aria-label="{{th_include}}" /></td><td>{{line}}</td><td><input type="text" name="identifier[{{index}}]" value="{{identifier}}" class="form-control" /></td><td><input type="text" name="groupname[{{index}}]" value="{{groupname}}" class="form-control" /></td><td><input type="text" name="groupingname[{{index}}]" value="{{groupingname}}" class="form-control" /></td><td>{{#haswarning}}<span class="local-groupimport-import-preview__status local-groupimport-import-preview__status--warning easyedu-status easyedu-status--warning">{{{statustext}}}</span>{{/haswarning}}{{^haswarning}}<span class="local-groupimport-import-preview__status local-groupimport-import-preview__status--ready easyedu-status">{{{readylabel}}}</span>{{/haswarning}}</td></tr>{{/rows}}</tbody></table>{{#haspagination}}<div class="easyedu-pagination local-groupimport-import-pagination"><button type="submit" name="previewpage" value="{{prevvalue}}" class="easyedu-button easyedu-button--secondary" aria-label="{{previousarialabel}}"{{#prevdisabled}} disabled="disabled"{{/prevdisabled}}><span class="fa fa-chevron-left" aria-hidden="true"></span></button><span class="easyedu-pagination__count">{{previewpagedisplay}} / {{pagecount}}</span><button type="submit" name="previewpage" value="{{nextvalue}}" class="easyedu-button easyedu-button--secondary" aria-label="{{nextarialabel}}"{{#nextdisabled}} disabled="disabled"{{/nextdisabled}}><span class="fa fa-chevron-right" aria-hidden="true"></span></button></div>{{/haspagination}}<input type="hidden" name="previewcomplete" value="{{rowstotal}}" /></div><div class="local-groupimport-import-empty local-groupimport-import-empty--preview-search easyedu-empty" data-local-groupimport-preview-empty="1" hidden="hidden"><span class="fa fa-search" aria-hidden="true"></span><p class="mb-0">{{{nopreviewmatches}}}</p></div><div class="easyedu-notice easyedu-notice--warning" role="note" data-local-groupimport-guide-path-warning="1" hidden="hidden"><span class="fa fa-exclamation-triangle" aria-hidden="true"></span><p>{{{guidewarning}}}</p></div><div class="local-groupimport-import-preview__actions"><button type="submit" class="easyedu-button" data-local-groupimport-preview-submit="1"><span class="fa fa-check" aria-hidden="true"></span>{{{submitimportlabel}}}</button><a class="easyedu-button easyedu-button--neutral" data-local-groupimport-preview-cancel="1" href="{{{cancelurl}}}">{{{cancellabel}}}</a></div></form>{{/preview}}{{#isemptystate}}<div class="local-groupimport-import-empty easyedu-empty"><svg class="easyedu-empty__boundary" aria-hidden="true" focusable="false"><rect width="100%" height="100%" rx="13.6"></rect></svg><span class="fa fa-inbox" aria-hidden="true"></span><p class="mb-0">{{{noresultslabel}}}</p></div>{{/isemptystate}}{{#report}}<div class="local-groupimport-import-summary" aria-label="{{importsummarylabel}}"><span class="local-groupimport-import-summary__item local-groupimport-import-summary__item--success easyedu-report-summary--success"><strong>{{successcount}}</strong> {{{successheaderlabel}}}</span><span class="local-groupimport-import-summary__item local-groupimport-import-summary__item--error"><strong>{{errorcount}}</strong> {{{errorheaderlabel}}}</span></div>{{#hassuccess}}<h4 class="local-groupimport-import-report__title local-groupimport-import-report__title--success easyedu-report-title--success">{{{successheaderlabel}}}</h4><ul class="local-groupimport-import-report local-groupimport-import-report--success easyedu-report-list--success">{{#successitems}}<li><span class="fa fa-check" aria-hidden="true"></span><span>{{{text}}}</span></li>{{/successitems}}</ul>{{/hassuccess}}{{#haserrors}}<h4 class="local-groupimport-import-report__title local-groupimport-import-report__title--error">{{{errorheaderlabel}}}</h4><ul class="local-groupimport-import-report local-groupimport-import-report--error">{{#erroritems}}<li><span class="fa fa-exclamation-triangle" aria-hidden="true"></span><span>{{{text}}}</span></li>{{/erroritems}}</ul>{{/haserrors}}{{#hasexport}}<div class="local-groupimport-import-preview__result-actions"><a class="btn btn-outline-primary easyedu-action-with-icon local-groupimport-import__export-results easyedu-button--outline-primary" href="{{{exporturl}}}"><span class="fa fa-file-excel" aria-hidden="true"></span><span>{{{importexportresultslabel}}}</span></a></div>{{/hasexport}}{{/report}}