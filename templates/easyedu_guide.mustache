<div class="easyedu-guide{{#rootclass}} {{rootclass}}{{/rootclass}}" data-easyedu-guide-root>
    <button
        type="button"
        class="btn easyedu-guide__launcher"
        data-easyedu-guide-open="1"
        aria-label="{{guideopenlabel}}"
    >
        <span class="easyedu-guide__launcher-icon" aria-hidden="true">
            <span class="fa fa-compass" aria-hidden="true"></span>
        </span>
        <span class="easyedu-guide__launcher-label" aria-hidden="true">{{guidehoverlabel}}</span>
    </button>

    <div class="easyedu-guide-modal" data-easyedu-guide-modal hidden role="dialog" aria-label="{{guidetitle}}">
        <div class="easyedu-guide-modal__dialog">
            <header class="easyedu-guide-modal__header">
                <div class="easyedu-guide-modal__title-wrap">
                    <span class="easyedu-guide-modal__hero-icon fa fa-compass" aria-hidden="true"></span>
                    <div>
                        <h2>{{guidetitle}}</h2>
                        <p>{{guidesubtitle}}</p>
                    </div>
                </div>
                <div class="easyedu-guide-modal__map-flow" aria-hidden="true">
                    <span class="easyedu-guide-modal__map-item easyedu-guide-modal__map-item--source">
                        <span class="fa fa-sitemap"></span>
                        <span>{{guidemapsource}}</span>
                    </span>
                    <span class="easyedu-guide-modal__map-arrow fa fa-arrow-right"></span>
                    <span class="easyedu-guide-modal__map-item easyedu-guide-modal__map-item--layer">
                        <span class="fa fa-layer-group"></span>
                        <span>{{guidemaplayers}}</span>
                    </span>
                    <span class="easyedu-guide-modal__map-arrow fa fa-arrow-right"></span>
                    <span class="easyedu-guide-modal__map-item easyedu-guide-modal__map-item--banner">
                        <span class="fa fa-image"></span>
                        <span>{{guidemapbanner}}</span>
                    </span>
                </div>
                <button type="button" class="btn easyedu-guide-modal__close" data-easyedu-guide-close="1" aria-label="{{guidecloselabel}}">
                    <span class="fa fa-times" aria-hidden="true"></span>
                </button>
            </header>

            <div class="easyedu-guide-nav-wrap">
                <button type="button" class="easyedu-guide-nav-arrow easyedu-guide-nav-arrow--prev" data-easyedu-guide-nav-previous="1" aria-label="{{guidepreviouslabel}}">
                    <span class="fa fa-chevron-left" aria-hidden="true"></span>
                </button>
                <nav class="easyedu-guide-modal__nav easyedu-guide-nav" data-easyedu-guide-nav aria-label="{{guidenavigationlabel}}">
                    {{#slides}}
                        <button
                            type="button"
                            class="easyedu-guide-nav-item{{#hasguidedpath}} has-guided-path{{/hasguidedpath}}"
                            data-easyedu-guide-nav-item="{{index}}"
                            {{#hasguidedpath}}data-easyedu-guided-label="{{guidebadgelabel}}"{{/hasguidedpath}}
                            {{#requires}}data-easyedu-guide-requires="{{requires}}"{{/requires}}
                            {{#requireslabel}}data-easyedu-guide-requires-label="{{requireslabel}}"{{/requireslabel}}
                        >
                            <span class="easyedu-guide-nav-item__icon" aria-hidden="true">
                                <span class="fa {{navicon}}" aria-hidden="true"></span>
                            </span>
                            <span class="easyedu-guide-nav-copy">
                                {{#category}}<small>{{category}}</small>{{/category}}
                                {{^category}}{{#hasguidedpath}}<small>{{guideguidedpathlabel}}</small>{{/hasguidedpath}}{{/category}}
                                <span>{{title}}</span>
                            </span>
                            {{#requires}}
                                <span class="easyedu-guide-nav-item__requirement" aria-hidden="true">{{#requiresbadge}}{{requiresbadge}}{{/requiresbadge}}{{^requiresbadge}}{{guiderequiresbadge}}{{/requiresbadge}}</span>
                            {{/requires}}
                        </button>
                    {{/slides}}
                </nav>
                <button type="button" class="easyedu-guide-nav-arrow easyedu-guide-nav-arrow--next" data-easyedu-guide-nav-next="1" aria-label="{{guidenextlabel}}">
                    <span class="fa fa-chevron-right" aria-hidden="true"></span>
                </button>
            </div>

            <div class="easyedu-guide-modal__progress">
                <div class="easyedu-guide-modal__progress-track">
                    <span
                        class="easyedu-guide-modal__progress-bar"
                        data-easyedu-guide-progress-bar
                        role="progressbar"
                        aria-label="{{guideprogresslabel}}"
                        aria-valuemin="1"
                        aria-valuemax="{{slidecount}}"
                        aria-valuenow="1"
                        style="width: {{initialprogress}}%;"
                    ></span>
                </div>
                <span class="easyedu-guide-modal__progress-label" data-easyedu-guide-progress-label>1/{{slidecount}}</span>
            </div>

            <div class="easyedu-guide-modal__body">
                {{#slides}}
                    <section
                        class="easyedu-guide-slide{{#visualtype}} easyedu-guide-slide--{{visualtype}}{{/visualtype}}"
                        data-easyedu-guide-slide="{{index}}"
                        {{#requires}}data-easyedu-guide-requires="{{requires}}"{{/requires}}
                        {{#visualtype}}data-easyedu-guide-visual-type="{{visualtype}}"{{/visualtype}}
                        hidden
                    >
                        <span class="easyedu-guide-slide__icon fa {{icon}}" aria-hidden="true"></span>
                        <div>
                            <div class="easyedu-guide-slide__header">
                                <h3>{{title}}</h3>
                                {{#target}}
                                    <button
                                        type="button"
                                        class="btn btn-outline-primary btn-sm easyedu-guide-slide__show"
                                        data-easyedu-guide-show-target="{{#targetselector}}{{targetselector}}{{/targetselector}}{{^targetselector}}{{target}}{{/targetselector}}"
                                        {{#targetselectorcompact}}data-easyedu-guide-show-target-compact="{{targetselectorcompact}}"{{/targetselectorcompact}}
                                        {{#targetselectordesktop}}data-easyedu-guide-show-target-desktop="{{targetselectordesktop}}"{{/targetselectordesktop}}
                                        {{#showopen}}data-easyedu-guide-show-open="{{showopen}}"{{/showopen}}
                                        {{#showopendelay}}data-easyedu-guide-show-open-delay="{{showopendelay}}"{{/showopendelay}}
                                        {{#showafteropen}}data-easyedu-guide-show-after-open="{{showafteropen}}"{{/showafteropen}}
                                        {{#showafteropendelay}}data-easyedu-guide-show-after-open-delay="{{showafteropendelay}}"{{/showafteropendelay}}
                                    >
                                        <span class="fa fa-location-arrow" aria-hidden="true"></span>
                                        <span>{{guideshowinterfacelabel}}</span>
                                    </button>
                                {{/target}}
                            </div>
                            <div class="easyedu-guide-slide__content">
                                {{{content}}}
                            </div>
                            {{#requires}}
                                <div class="easyedu-guide-slide__locked">
                                    <span class="easyedu-guide-slide__locked-icon fa fa-lock" aria-hidden="true"></span>
                                    <div>
                                        <h4>{{requirestitle}}</h4>
                                        <p>{{requirescontent}}</p>
                                        {{#unlockpath}}
                                            <button type="button" class="btn btn-primary easyedu-guide-slide__start easyedu-guide-slide__unlock" data-easyedu-guide-start-path="{{unlockpath}}">
                                                <span class="fa fa-tasks" aria-hidden="true"></span>
                                                <span>{{unlocklabel}}</span>
                                            </button>
                                        {{/unlockpath}}
                                    </div>
                                </div>
                            {{/requires}}
                            {{#hasvisualflow}}
                                <div class="easyedu-guide-visual easyedu-guide-visual--flow" aria-hidden="true">
                                    <span class="easyedu-guide-mini-card easyedu-guide-mini-card--source">
                                        <span class="fa fa-sitemap"></span>
                                        <strong>{{guidemapsource}}</strong>
                                    </span>
                                    <span class="easyedu-guide-flow-arrow fa fa-arrow-right"></span>
                                    <span class="easyedu-guide-mini-card easyedu-guide-mini-card--layer">
                                        <span class="fa fa-layer-group"></span>
                                        <strong>{{guidemaplayers}}</strong>
                                    </span>
                                    <span class="easyedu-guide-flow-arrow fa fa-arrow-right"></span>
                                    <span class="easyedu-guide-mini-card easyedu-guide-mini-card--banner">
                                        <span class="fa fa-image"></span>
                                        <strong>{{guidemapbanner}}</strong>
                                    </span>
                                </div>
                            {{/hasvisualflow}}
                            {{#visualcards}}
                                <div class="easyedu-guide-visual easyedu-guide-visual--cards" aria-hidden="true">
                                    {{#items}}
                                        <span class="easyedu-guide-visual-card{{#type}} easyedu-guide-visual-card--{{type}}{{/type}}">
                                            {{#icon}}<span class="fa {{icon}}" aria-hidden="true"></span>{{/icon}}
                                            <strong>{{title}}</strong>
                                            {{#meta}}<small>{{meta}}</small>{{/meta}}
                                        </span>
                                    {{/items}}
                                </div>
                            {{/visualcards}}
                            {{#visualcarddetail}}
                                <div class="easyedu-guide-visual easyedu-guide-visual--card-detail" aria-hidden="true">
                                    {{#card}}
                                        <span class="easyedu-guide-visual-card{{#type}} easyedu-guide-visual-card--{{type}}{{/type}}">
                                            {{#icon}}<span class="fa {{icon}}" aria-hidden="true"></span>{{/icon}}
                                            <strong>{{title}}</strong>
                                            {{#meta}}<small>{{meta}}</small>{{/meta}}
                                        </span>
                                    {{/card}}
                                    <span class="easyedu-guide-detail-list">
                                        {{#details}}
                                            <span{{#type}} class="easyedu-guide-detail-list__item--{{type}}"{{/type}}>
                                                {{#icon}}<span class="fa {{icon}}" aria-hidden="true"></span>{{/icon}}
                                                <span>{{label}}</span>
                                            </span>
                                        {{/details}}
                                    </span>
                                </div>
                            {{/visualcarddetail}}
                            {{#visualassignment}}
                                <div class="easyedu-guide-visual easyedu-guide-visual--assignment" aria-hidden="true">
                                    {{#rows}}
                                        <span class="easyedu-guide-assignment-row">
                                            {{#items}}
                                                <span class="easyedu-guide-mini-card{{#type}} easyedu-guide-mini-card--{{type}}{{/type}}">
                                                    {{#icon}}<span class="fa {{icon}}" aria-hidden="true"></span>{{/icon}}
                                                    <strong>{{title}}</strong>
                                                    {{#meta}}<small>{{meta}}</small>{{/meta}}
                                                </span>
                                                {{#arrowafter}}<span class="easyedu-guide-flow-arrow fa fa-arrow-right"></span>{{/arrowafter}}
                                            {{/items}}
                                        </span>
                                    {{/rows}}
                                </div>
                            {{/visualassignment}}
                            {{#visualfiltersdemo}}
                                <div class="easyedu-guide-visual easyedu-guide-visual--filters" aria-hidden="true">
                                    <span class="easyedu-guide-fake-search">
                                        <span class="fa fa-search" aria-hidden="true"></span>
                                        <span>{{searchlabel}}</span>
                                    </span>
                                    {{#actions}}
                                        <span class="easyedu-guide-fake-button">{{label}}</span>
                                    {{/actions}}
                                    {{#badges}}
                                        <span class="easyedu-guide-demo-badge{{#type}} easyedu-guide-demo-badge--{{type}}{{/type}}">{{label}}</span>
                                    {{/badges}}
                                </div>
                            {{/visualfiltersdemo}}
                            {{#visualpaste}}
                                <div class="easyedu-guide-visual easyedu-guide-visual--paste" aria-hidden="true">
                                    {{#panels}}
                                        <span class="easyedu-guide-paste-panel">
                                            <strong>
                                                {{#icon}}<span class="fa {{icon}}" aria-hidden="true"></span>{{/icon}}
                                                <span>{{title}}</span>
                                            </strong>
                                            <span class="easyedu-guide-fake-input">{{input}}</span>
                                            <span class="easyedu-guide-chip-row">
                                                {{#chips}}<span>{{.}}</span>{{/chips}}
                                            </span>
                                        </span>
                                        {{#arrowafter}}<span class="easyedu-guide-flow-arrow fa fa-arrow-right"></span>{{/arrowafter}}
                                    {{/panels}}
                                </div>
                            {{/visualpaste}}
                            {{#visualcontextmenu}}
                                <div class="easyedu-guide-visual easyedu-guide-visual--context-menu" aria-hidden="true">
                                    <span class="easyedu-guide-mouse-demo">
                                        <span class="easyedu-guide-mouse-card">
                                            {{#cardicon}}<span class="fa {{cardicon}}" aria-hidden="true"></span>{{/cardicon}}
                                            <strong>{{cardlabel}}</strong>
                                        </span>
                                        <span class="easyedu-guide-mouse-pointer">
                                            <span class="easyedu-guide-mouse-click"></span>
                                        </span>
                                    </span>
                                    <span class="easyedu-guide-demo-menu">
                                        <strong>
                                            <span class="fa fa-mouse-pointer" aria-hidden="true"></span>
                                            <span>{{menutitle}}</span>
                                        </strong>
                                        {{#items}}
                                            <span>{{#icon}}<span class="fa {{icon}}" aria-hidden="true"></span>{{/icon}}{{label}}</span>
                                        {{/items}}
                                    </span>
                                    <span class="easyedu-guide-context-note">{{note}}</span>
                                </div>
                            {{/visualcontextmenu}}
                            {{#visualactionflow}}
                                <div class="easyedu-guide-visual easyedu-guide-visual--action-flow" aria-hidden="true">
                                    <span class="easyedu-guide-selection-stack">
                                        {{#selection}}
                                            <span><span class="fa fa-check-square" aria-hidden="true"></span>{{.}}</span>
                                        {{/selection}}
                                    </span>
                                    <span class="easyedu-guide-fake-button">
                                        {{#actionicon}}<span class="fa {{actionicon}}" aria-hidden="true"></span>{{/actionicon}}
                                        <span>{{actionlabel}}</span>
                                    </span>
                                    <span class="easyedu-guide-modal-preview">
                                        <strong>{{destinationtitle}}</strong>
                                        {{#destinations}}<span>{{.}}</span>{{/destinations}}
                                    </span>
                                </div>
                            {{/visualactionflow}}
                            {{#visualdragdrop}}
                                <div class="easyedu-guide-visual easyedu-guide-visual--drag-drop" aria-hidden="true">
                                    {{#lanes}}
                                        <span class="easyedu-guide-drag-lane">
                                            <span class="easyedu-guide-demo-card{{#sourcetype}} easyedu-guide-demo-card--{{sourcetype}}{{/sourcetype}}">
                                                {{#sourceicon}}<span class="fa {{sourceicon}}" aria-hidden="true"></span>{{/sourceicon}}
                                                <strong>{{sourcelabel}}</strong>
                                            </span>
                                            <span class="easyedu-guide-demo-cursor fa fa-mouse-pointer" aria-hidden="true"></span>
                                            <span class="easyedu-guide-demo-drop">
                                                {{#targeticon}}<span class="fa {{targeticon}}" aria-hidden="true"></span>{{/targeticon}}
                                                <strong>{{targetlabel}}</strong>
                                            </span>
                                        </span>
                                    {{/lanes}}
                                    <span class="easyedu-guide-demo-selection">
                                        {{#selection}}
                                            <span><span class="fa fa-check-square" aria-hidden="true"></span>{{.}}</span>
                                        {{/selection}}
                                    </span>
                                    <span class="easyedu-guide-demo-menu">
                                        {{#menuitems}}
                                            <span>{{#icon}}<span class="fa {{icon}}" aria-hidden="true"></span>{{/icon}}{{label}}</span>
                                        {{/menuitems}}
                                    </span>
                                </div>
                            {{/visualdragdrop}}
                            {{#visualformula}}
                                <div class="easyedu-guide-visual easyedu-guide-visual--formula" aria-hidden="true">
                                    <code>{{expression}}</code>
                                    <span class="easyedu-guide-flow-arrow fa fa-arrow-right"></span>
                                    {{#results}}<span class="easyedu-guide-formula-result">{{.}}</span>{{/results}}
                                </div>
                            {{/visualformula}}
                            {{#visualsteps}}
                                <div class="easyedu-guide-visual easyedu-guide-visual--steps{{#layout}} easyedu-guide-visual--{{layout}}{{/layout}}" aria-hidden="true">
                                    {{#items}}
                                        <span class="easyedu-guide-step-pill{{#state}} easyedu-guide-step-pill--{{state}}{{/state}}">
                                            {{#icon}}<span class="fa {{icon}}" aria-hidden="true"></span>{{/icon}}
                                            <span>{{label}}</span>
                                        </span>
                                    {{/items}}
                                </div>
                            {{/visualsteps}}
                            {{#visualkeys}}
                                <div class="easyedu-guide-visual easyedu-guide-visual--keyboard" aria-hidden="true">
                                    {{#items}}
                                        <span>
                                            <kbd>{{key}}</kbd>
                                            <span>{{label}}</span>
                                        </span>
                                    {{/items}}
                                </div>
                            {{/visualkeys}}
                            {{#guidedpath}}
                                <div class="easyedu-guide-guided-card">
                                    <span class="easyedu-guide-guided-card__icon fa fa-route" aria-hidden="true"></span>
                                    <div class="easyedu-guide-guided-card__body">
                                        <strong>{{#guidedpathtitle}}{{guidedpathtitle}}{{/guidedpathtitle}}{{^guidedpathtitle}}{{title}}{{/guidedpathtitle}}</strong>
                                        <span>{{#guidedpathcontent}}{{guidedpathcontent}}{{/guidedpathcontent}}{{^guidedpathcontent}}{{guideguidedpathlabel}}{{/guidedpathcontent}}</span>
                                        {{#guidedpathsteps}}
                                            <ol class="easyedu-guide-guided-card__steps">
                                                {{#items}}<li>{{.}}</li>{{/items}}
                                            </ol>
                                        {{/guidedpathsteps}}
                                    </div>
                                    <button type="button" class="btn btn-primary easyedu-guide-slide__start" data-easyedu-guide-start-path="{{guidedpath}}">
                                        <span class="fa fa-play" aria-hidden="true"></span>
                                        <span>{{guidestartpathlabel}}</span>
                                    </button>
                                </div>
                            {{/guidedpath}}
                        </div>
                    </section>
                {{/slides}}
            </div>

            <footer class="easyedu-guide-modal__footer">
                <span class="easyedu-guide-modal__step-count" data-easyedu-guide-progress-label data-progress-label="{{guidesteplabel}}">1/{{slidecount}}</span>
                <div class="easyedu-guide-modal__footer-actions">
                    <button type="button" class="btn btn-outline-secondary" data-easyedu-guide-previous="1">{{guidepreviouslabel}}</button>
                    <button type="button" class="btn btn-primary" data-easyedu-guide-next="1">{{guidenextlabel}}</button>
                </div>
            </footer>
        </div>
    </div>

    <aside class="easyedu-guide-interface-return" data-easyedu-guide-interface-return hidden role="region" aria-label="{{guidereturnlabel}}">
        <div class="easyedu-guide-interface-return__text">
            <strong>{{guidereturnlabel}}</strong>
            <span>{{guidereturndesc}}</span>
        </div>
        <div class="easyedu-guide-interface-return__actions">
            <button type="button" class="btn btn-primary btn-sm easyedu-guide-interface-return__button" data-easyedu-guide-interface-return-button="1">
                <span class="fa fa-question-circle" aria-hidden="true"></span>
                <span>{{guidereturnbutton}}</span>
            </button>
            <button
                type="button"
                class="btn btn-outline-secondary btn-sm easyedu-guide-interface-return__dismiss"
                data-easyedu-guide-interface-return-dismiss="1"
                aria-label="{{guidereturndismiss}}"
            >
                <span class="fa fa-times" aria-hidden="true"></span>
            </button>
        </div>
    </aside>

    <aside class="easyedu-guide-checklist easyedu-guided-panel" data-easyedu-guide-checklist hidden role="region" aria-label="{{guidechecklisttitle}}">
        <div class="easyedu-guide-checklist__header easyedu-guided-panel__header">
            <div>
                <strong data-easyedu-guide-checklist-title>{{guidechecklisttitle}}</strong>
                <span data-easyedu-guide-checklist-subtitle>{{guideguidedpathlabel}}</span>
            </div>
            <div class="easyedu-guided-panel__header-actions">
                <button type="button" class="btn btn-link easyedu-guided-panel__minimize" data-easyedu-guide-checklist-minimize="1" aria-label="{{guideminimizelabel}}" aria-expanded="true">
                    <span class="fa fa-minus" aria-hidden="true"></span>
                </button>
                <button type="button" class="btn btn-link easyedu-guided-panel__close" data-easyedu-guide-checklist-close="1" aria-label="{{guidecloselabel}}">
                    <span class="fa fa-times" aria-hidden="true"></span>
                </button>
            </div>
        </div>
        <div class="easyedu-guide-checklist__items easyedu-guided-panel__steps" data-easyedu-guide-checklist-items></div>
        <div
            class="easyedu-guide-checklist__complete easyedu-guided-panel__message"
            data-easyedu-guide-checklist-message
            data-complete-message="{{guidechecklistdonelabel}}"
            role="status"
            aria-live="polite"
            aria-atomic="true"
        >
            <span class="fa fa-location-arrow" aria-hidden="true"></span>
            <span data-easyedu-guide-checklist-message-text>{{guidechecklistdonelabel}}</span>
            <span class="easyedu-guided-panel__message-compact" aria-hidden="true">{{guidechecklistdonelabel}}</span>
        </div>
        <div class="easyedu-guided-panel__footer">
            <button type="button" class="btn btn-outline-primary btn-sm easyedu-guided-panel__return" data-easyedu-guide-checklist-return="1">
                <span class="fa fa-question-circle" aria-hidden="true"></span>
                <span>{{guidereturnbutton}}</span>
            </button>
        </div>
    </aside>
</div>
