{{!
    @template local_groupimport/sm/context_action

    One action of the card context menu, at the top level or inside a submenu
    ("Copy", "Add participants", "Add groups"). Both levels share this markup so
    the menu controller runs every action through the same branch.
    HTML validation runs in manage, whose example supplies both menu parents.

    Example context (json):
    {
        "action": "copy-group-name",
        "contexts": "group",
        "icon": "fa-copy",
        "label": "Group name",
        "multilabel": "Group names",
        "fieldkey": ""
    }
}}
<button
    type="button"
    data-easystud-context-action="{{action}}"
    data-easystud-contexts="{{contexts}}"
    data-easystud-context-label="{{label}}"
    {{#multilabel}}data-easystud-context-multi-label="{{multilabel}}"{{/multilabel}}
    {{#fieldkey}}data-easystud-context-field="{{fieldkey}}"{{/fieldkey}}
    role="menuitem"
>
    <span class="fa {{icon}}" aria-hidden="true"></span>
    <span data-easystud-context-text="1">{{label}}</span>
</button>
