{{! Server confirmation: shared Kit classes only; no inline style or business script.
    inline: rendered closed on the admin settings page and opened there by js/admin_guide_reset.js;
    otherwise the standalone page renders it open. }}
<div class="easyedu-ui{{^inline}} easyedu-ui--standalone{{/inline}}"{{#motionlevel}} data-easyedu-motion-level="{{motionlevel}}"{{/motionlevel}}>
    <dialog id="easyedu-welcome-reset" class="easyedu-confirmation-dialog easyedu-confirmation-dialog--modal"{{^inline}} open{{/inline}} aria-labelledby="easyedu-welcome-reset-title" aria-describedby="easyedu-welcome-reset-description">
        <header class="easyedu-dialog-header">
            <h2 id="easyedu-welcome-reset-title" class="easyedu-modal-title">{{title}}</h2>
            {{#inline}}
            <button type="button" class="easyedu-dialog-close" aria-label="{{cancel}}" data-local-groupimport-welcome-reset-close><span class="fa fa-times" aria-hidden="true"></span></button>
            {{/inline}}
            {{^inline}}
            <a class="easyedu-dialog-close" href="{{cancelurl}}" aria-label="{{cancel}}"><span class="fa fa-times" aria-hidden="true"></span></a>
            {{/inline}}
        </header>
        {{! Inline: the settings page is already a form; the script posts its own form. }}
        {{#inline}}
        <div class="easyedu-dialog-body" data-local-groupimport-welcome-reset-action="{{action}}" data-local-groupimport-welcome-reset-sesskey="{{sesskey}}">
            <p id="easyedu-welcome-reset-description" class="easyedu-dialog-description">{{description}}</p>
        {{/inline}}
        {{^inline}}
        <form class="easyedu-dialog-body" method="post" action="{{action}}">
            <p id="easyedu-welcome-reset-description" class="easyedu-dialog-description">{{description}}</p>
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <input type="hidden" name="confirm" value="1">
        {{/inline}}
            <div class="easyedu-confirmation-dialog__actions">
                {{#inline}}
                <button type="button" class="easyedu-button--secondary" data-local-groupimport-welcome-reset-close>{{cancel}}</button>
                {{/inline}}
                {{^inline}}
                <a class="easyedu-button--secondary" href="{{cancelurl}}" data-easyedu-dialog-cancel>{{cancel}}</a>
                {{/inline}}
                {{#inline}}
                <button class="easyedu-button" type="button" data-local-groupimport-welcome-reset-confirm>{{confirm}}</button>
                {{/inline}}
                {{^inline}}
                <button class="easyedu-button" type="submit">{{confirm}}</button>
                {{/inline}}
            </div>
        {{#inline}}
        </div>
        {{/inline}}
        {{^inline}}
        </form>
        {{/inline}}
    </dialog>
</div>
