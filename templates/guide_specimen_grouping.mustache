{{!
    @template local_groupimport/guide_specimen_grouping

    Illustration only: one grouping card drawn with the real card classes of the
    product (tree section, header, counter, hover actions, child group cards, empty
    row, group-name panel), without any data-easystud-* hook, link or form control.
    See guide_specimen_group for the visibility of the hover-only actions.

    Example context (json):
    {
        "groupingname": "Année 2026",
        "groupingcount": 2,
        "groupingexpanded": true,
        "groupingactions": true,
        "groupingpath": false,
        "groupingpointer": false,
        "groups": []
    }
}}
<div class="local-groupimport-easystud-tree__section{{#groupingexpanded}} is-expanded{{/groupingexpanded}}{{#groupingpath}} is-guide-path{{/groupingpath}}">
    <span class="local-groupimport-easystud-selector local-groupimport-easystud-selector--section" aria-hidden="true">
        <input type="checkbox" tabindex="-1" aria-hidden="true">
        <span class="local-groupimport-easystud-selector__ui" aria-hidden="true"></span>
    </span>
    <div class="local-groupimport-easystud-grouping__header">
        <span class="local-groupimport-easystud-tree__toggle">
            <span class="fa {{#groupingexpanded}}fa-chevron-down{{/groupingexpanded}}{{^groupingexpanded}}fa-chevron-right{{/groupingexpanded}}" aria-hidden="true"></span>
            <span class="local-groupimport-easystud-grouping__name">{{groupingname}}</span>
        </span>
        {{#groupingactions}}
        <span class="btn btn-link p-0 local-groupimport-easystud-group__mail-button is-easyedu-guide-highlight-target{{#groupingpointer}} is-guide-pointed{{/groupingpointer}}"><span class="fa fa-layer-group" aria-hidden="true"></span></span>
        <span class="btn btn-link p-0 local-groupimport-easystud-container-search__toggle is-easyedu-guide-highlight-target"><span class="fa fa-search" aria-hidden="true"></span></span>
        <span class="btn btn-link p-0 local-groupimport-easystud-grouping__duplicate-button is-easyedu-guide-highlight-target"><span class="fa fa-copy" aria-hidden="true"></span></span>
        <span class="btn btn-link p-0 local-groupimport-easystud-grouping__settings-button is-easyedu-guide-highlight-target"><span class="fa fa-cog" aria-hidden="true"></span></span>
        <span class="btn btn-link p-0 local-groupimport-easystud-rename__toggle is-easyedu-guide-highlight-target"><span class="fa fa-pen" aria-hidden="true"></span></span>
        {{/groupingactions}}
        <span class="badge bg-secondary text-white local-groupimport-easystud-count-badge local-groupimport-easystud-count-badge--{{#groupingcountempty}}empty{{/groupingcountempty}}{{^groupingcountempty}}filled{{/groupingcountempty}} local-groupimport-easystud-count-badge--grouping"><span class="fa fa-layer-group" aria-hidden="true"></span><span>{{groupingcount}}</span></span>
    </div>
    {{#groupingpanel}}
    <div class="local-groupimport-easystud-group-email easyedu-guide-spec__panel is-open">
        <textarea class="form-control form-control-sm" rows="2" readonly tabindex="-1" aria-hidden="true">{{panelvalue}}</textarea>
        <div class="easyedu-guide-scene__inspection-chips" aria-hidden="true">
            {{#panelchips}}<span{{#unresolved}} class="is-unresolved"{{/unresolved}}><span class="fa {{#unresolved}}fa-question{{/unresolved}}{{^unresolved}}fa-check{{/unresolved}}" aria-hidden="true"></span> {{chiplabel}}</span>{{/panelchips}}
        </div>
        <div class="local-groupimport-easystud-inline-actions">
            <span class="btn btn-sm btn-primary"><span class="fa fa-plus" aria-hidden="true"></span> <span>{{panelsubmit}}</span></span>
            <span class="btn btn-sm btn-outline-secondary">{{panelcancel}}</span>
        </div>
    </div>
    {{/groupingpanel}}
    {{#groupingexpanded}}
    <div class="local-groupimport-easystud-tree__children local-groupimport-easystud-grouping__groups is-expanded">
        {{#groupingempty}}
        <div class="local-groupimport-easystud-tree__empty easyedu-entity-card-empty easyedu-entity-card-empty--grouping">
            <span class="easyedu-entity-card-empty__icon" aria-hidden="true"><span class="fa fa-layer-group"></span></span>
            <span class="easyedu-entity-card-empty__copy"><span>{{groupingemptytext}}</span><small class="easyedu-entity-card-empty__help">{{groupingemptyhelp}}</small></span>
        </div>
        {{/groupingempty}}
        {{#groups}}{{> local_groupimport/guide_specimen_group}}{{/groups}}
    </div>
    {{/groupingexpanded}}
</div>
